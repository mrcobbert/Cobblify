{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cobblify Launcher",
  "version": "0.18.1",
  "identifier": "club.cobblify.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Cobblify",
        "width": 900,
        "height": 520,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#1A1A1A",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5M0MyN0M0MzZGODRCQTYKUldTbVMvZzJ4Q2M4R2J0TytDb1h6amRmTExETTBnOFVSSysxN1pIdVRnd0ozQjlDcnBvZWs1dG8K",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": ["resources/"],
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./nsis/hooks.nsh"
      }
    }
  }
}
