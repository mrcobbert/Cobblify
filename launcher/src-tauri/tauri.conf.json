{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cobblify Launcher",
  "version": "0.10.0",
  "identifier": "club.cobblify.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Cobblify",
        "width": 900,
        "height": 620,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": "",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": ["resources/"],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
