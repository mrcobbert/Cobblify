class Mapper:
    """Maps agent-only paths (this worktree, the Gradle caches) to readable copies under SHARED."""

    def __init__(self, wt, runtime):
        self.wt = wt
        self.runtime = runtime

    def dest(self, src):
        if src.startswith(SHARED + "/"):
            return src
        if src.startswith(GRADLE_CACHES + "/"):
            return SHARED + "/cache/gradle/" + src[len(GRADLE_CACHES) + 1:]
        if src.startswith(self.wt + "/"):
            return self.runtime + "/wt/" + src[len(self.wt) + 1:]
        die("the launch config references a path cobdev does not know how to share: " + src)

    def stage(self, src):
        dst = self.dest(src)
        if dst == src:
            return dst
        if os.path.isdir(src):
            copy_tree(src, dst)
        elif os.path.exists(src):
            copy_file(src, dst)
        return dst

    def rewrite(self, text):
        return text.replace(self.wt + "/", self.runtime + "/wt/").replace(GRADLE_CACHES + "/", SHARED + "/cache/gradle/")


CFG_PATH = re.compile(r"/Users/[^\s:=,]+")
NATIVES_PROPS = ("java.library.path=", "org.lwjgl.librarypath=")


def rewrite_launch_cfg(cfg, mapper, drop_natives):
    """DevLaunchInjector's launch.cfg for the shared runtime: paths rewritten, our client args added.

    drop_natives: Pylon brings LWJGL 3 natives in its own jar; Loom's natives dir holds LWJGL 2's, and
    org.lwjgl.librarypath would point LWJGL 3 at the wrong directory.
    """
    lines = []
    for line in cfg.splitlines():
        if drop_natives and line.strip().startswith(NATIVES_PROPS):
            continue
        lines.append(line)
        if line == "clientArgs":
            lines += ["\t--username", "\tCobblifyDev", "\t--width", "\t1280", "\t--height", "\t720"]
    if "clientArgs" not in lines:
        lines += ["clientArgs", "\t--username", "\tCobblifyDev", "\t--width", "\t1280", "\t--height", "\t720"]
    return mapper.rewrite("\n".join(lines) + "\n")


def cfg_values(cfg, key):
