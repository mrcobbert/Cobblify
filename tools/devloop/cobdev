# Vanilla 1.8.9 font advances (glyph + 1 px column), as the unit tests use them.
_NARROW = {" ": 4, "!": 2, "\"": 5, "'": 3, "(": 5, ")": 5, "*": 5, ",": 2, ".": 2, ":": 2, ";": 2, "<": 5,
           ">": 5, "@": 7, "I": 4, "[": 4, "]": 4, "`": 3, "f": 5, "i": 2, "k": 5, "l": 3, "t": 4, "{": 5,
           "|": 2, "}": 5, "~": 7}


def vanilla_width(text):
    return sum(_NARROW.get(c, 6) for c in text)


def ring(box, inset):
    """Points on the rectangle `inset` px inside box, each once; [] when the box is too small."""
    x0, y0, x1, y1 = box[0] + inset, box[1] + inset, box[2] - inset, box[3] - inset
    if x1 < x0 or y1 < y0:
        return []
    pts = [(x, y0) for x in range(x0, x1 + 1)]
    if y1 > y0:
        pts += [(x, y1) for x in range(x0, x1 + 1)]
    pts += [(x0, y) for y in range(y0 + 1, y1)]
    if x1 > x0:
        pts += [(x1, y) for y in range(y0 + 1, y1)]
    return pts


def see_through_ok(on_px, off_px, alpha=HL_FILL_ALPHA, tol=2):
    """Is on_px the backdrop off_px under black at `alpha`? (each channel round(c * (1 - alpha/255)) +- tol)"""
    return all(abs(a - round(b * (1 - alpha / 255.0))) <= tol for a, b in zip(on_px, off_px))


def count_exact(img, box, rgb):
    x0, y0, x1, y1 = box
    return sum(1 for y in range(y0, y1 + 1) for x in range(x0, x1 + 1) if px(img, x, y) == tuple(rgb))


def count_near(img, box, rgb, tol):
    x0, y0, x1, y1 = box
    return sum(1 for y in range(y0, y1 + 1) for x in range(x0, x1 + 1)
               if max(abs(c - t) for c, t in zip(px(img, x, y), rgb)) <= tol)


def xs_of(img, box, rgb):
    """(min x, max x) of the pixels exactly rgb in box, or None."""
    xs = [x for y in range(box[1], box[3] + 1) for x in range(box[0], box[2] + 1) if px(img, x, y) == tuple(rgb)]
    return (min(xs), max(xs)) if xs else None


def ys_of(img, box, rgb):
    ys = [y for y in range(box[1], box[3] + 1) for x in range(box[0], box[2] + 1) if px(img, x, y) == tuple(rgb)]
    return (min(ys), max(ys)) if ys else None


def bbox_diff(a, b, box=None, thresh=6):
    """Exact bounding box of the pixels that differ between two frames (every pixel, unlike diff())."""
    w, h, _ = a
    if (w, h) != b[:2]:
        return None
    x0, y0, x1, y1 = box or (0, 0, w - 1, h - 1)
    bb = None
    for y in range(max(0, y0), min(h - 1, y1) + 1):
        for x in range(max(0, x0), min(w - 1, x1) + 1):
            pa, pb = px(a, x, y), px(b, x, y)
            if max(abs(pa[0] - pb[0]), abs(pa[1] - pb[1]), abs(pa[2] - pb[2])) > thresh:
                bb = [x, y, x, y] if bb is None else [min(bb[0], x), min(bb[1], y), max(bb[2], x), max(bb[3], y)]
    return tuple(bb) if bb else None


def changed_runs(a, b, box, axis, thresh=6):
    """Sub-boxes of box split at the columns (axis "x") or rows ("y") where nothing changed."""
    x0, y0, x1, y1 = box
    lines = range(x0, x1 + 1) if axis == "x" else range(y0, y1 + 1)

    def hit(i):
        cells = ((i, y) for y in range(y0, y1 + 1)) if axis == "x" else ((x, i) for x in range(x0, x1 + 1))
        return any(max(abs(p - q) for p, q in zip(px(a, x, y), px(b, x, y))) > thresh for x, y in cells)
    runs, start = [], None
    for i in lines:
        if hit(i):
            start = i if start is None else start
        elif start is not None:
            runs.append((start, i - 1))
            start = None
    if start is not None:
        runs.append((start, lines[-1]))
    out = []
    for lo, hi in runs:
        sub = (lo, y0, hi, y1) if axis == "x" else (x0, lo, x1, hi)
        tight = bbox_diff(a, b, sub, thresh)
        if tight:
            out.append(tight)
    return out


def inside(inner, outer):
    return (inner is not None and outer is not None and inner[0] >= outer[0] and inner[1] >= outer[1]
            and inner[2] <= outer[2] and inner[3] <= outer[3])


def disjoint(boxes):
    for i, a in enumerate(boxes):
        for b in boxes[i + 1:]:
            if a[0] <= b[2] and b[0] <= a[2] and a[1] <= b[3] and b[1] <= a[3]:
                return False
    return True


def grow(box, d):
    return (box[0] - d, box[1] - d, box[2] + d, box[3] + d)


def box_size(box):
    return (box[2] - box[0] + 1, box[3] - box[1] + 1) if box else (0, 0)


def hl_text_box_width(segments, divider=False):
    """TextModules.boxWidth with vanilla advances: text minus its trailing column, plus 4 px each side."""
    return sum(vanilla_width(t) for t in segments) + (7 if divider else 0) - 1 + 8


# Module groups for the per-item checks: name, enable field, Background ids it switches, content kind.
HL_GROUPS = [
    ("potion", "potionStatusEnabled", ["potion"], "text"),
    ("armor", "armorTypeEnabled", ["armor"], "armor"),
    ("inventory", "inventoryHudEnabled", ["inventory"], "inventory"),
    ("timers", "genTimersEnabled", ["diamondtimer", "emeraldtimer"], "text"),
    ("sessionstats", "sessionStatsEnabled", ["sessionstats"], "text"),
    ("heightlimit", "heightLimitEnabled", ["heightlimit"], "text"),
    ("fps", "fpsEnabled", ["fps"], "textbox"),
    ("cps", "cpsEnabled", ["cps"], "textbox"),
    ("ping", "pingEnabled", ["ping"], "textbox"),
    ("keystrokes", "keystrokesEnabled", ["keystrokes"], "keys"),
]
HL_TEAM_UPGRADES = ("teamupgrades", "teamUpgradesEnabled", ["teamupgrades"], "text")
HL_LAYOUT = {"potion": "potionHud", "armor": "armorHud", "inventory": "inventoryHud",
             "diamondtimer": "diamondTimerHud", "emeraldtimer": "emeraldTimerHud", "keystrokes": "keystrokesHud",
             "sessionstats": "sessionStatsHud", "heightlimit": "heightLimitHud", "fps": "fpsHud", "cps": "cpsHud",
             "ping": "pingHud", "teamupgrades": "teamUpgradesHud"}
HL_OTHER_FIELDS = ["potionInGameOnly", "armorInGameOnly", "inventoryInGameOnly", "genTimersInGameOnly",
                   "keystrokesInGameOnly", "heightLimitInGameOnly", "sessionStatsHoldKey", "guiFont", "guiAccent",
                   "defaultTextSize"]
# Keystrokes caps (KeystrokesLayout.CAPS), GUI px from the module's top-left at scale 1.
HL_CAPS = [(19, 0, 18, 18), (0, 19, 18, 18), (19, 19, 18, 18), (38, 19, 18, 18), (0, 57, 56, 10),
           (0, 38, 27.5, 18), (28.5, 38, 27.5, 18)]


class HudLook:
    """State for the HL step: the config paths it touches, their values before it ran, the scale factor."""

    def __init__(self, s, cfg, restart_game):
        self.s, self.cfg, self.restart_game = s, cfg, restart_game
        self.groups = list(HL_GROUPS)
        if find_field(s, cfg, ["teamUpgradesEnabled"]):
            self.groups.append(HL_TEAM_UPGRADES)
        self.ids = [i for g in self.groups for i in g[2]]
        self.fields = [g[1] for g in self.groups] + HL_OTHER_FIELDS
        for i in self.ids:
            self.fields += [HL_LAYOUT[i] + k for k in ("X", "Y", "Anchor", "Scale")]
        self.saved, self.saved_bg, self.saved_gui = {}, {}, None
        self.sf = 2

    def f(self, name, value=None):
        return self.s.field(self.cfg + "." + name, value)

    def bg(self, item, on=None):
        if on is None:
            return self.s.call("/invoke", post={"path": self.cfg + ".hudBackground", "args": item}).get("value")
        self.s.call("/invoke", post={"path": self.cfg + ".setHudBackground", "args": ARG_SEP.join([item, str(on).lower()])})

    def group_bg(self, group, on):
        for item in group[2]:
            self.bg(item, on)

    def save_config(self):
        self.s.try_call("/invoke", post={"path": self.cfg + ".save", "args": ""})

    def snapshot(self):
        for name in self.fields:
            r, _ = self.s.try_call("/field", post={"path": self.cfg + "." + name})
            if r is not None:
                self.saved[name] = r.get("value")
        for i in self.ids:
            self.saved_bg[i] = self.bg(i)
        self.saved_gui = (self.s.status() or {}).get("guiScaleSetting")

    def restore(self):
        for name, value in self.saved.items():
            self.s.try_call("/field", post={"path": self.cfg + "." + name, "value": str(value).lower()
                                            if isinstance(value, bool) else str(value)})
        for i, on in self.saved_bg.items():
            if on is not None:
                self.bg(i, bool(on))
        if self.saved_gui is not None:
            self.s.try_call("/scale", {"n": self.saved_gui})
        self.s.try_call("/field", post={"path": ICONS + ".cacheDirOverride", "value": ""})
        self.save_config()
        self.s.try_call("/command", post={"command": "/gamerule sendCommandFeedback true"})

    def setup(self, gui_scale=2):
        """The fixed scene: noon, clear, looking north from a known spot, one item stack each in main slots 9-10."""
        for c in ("/gamerule sendCommandFeedback false", "/gamerule doDaylightCycle false", "/time set 6000",
                  "/weather clear", "/tp @p 0.5 4 0.5 0 0", "/effect @p clear",
                  "/replaceitem entity @p slot.armor.legs minecraft:diamond_leggings",
                  "/replaceitem entity @p slot.inventory.0 minecraft:diamond 4",
                  "/replaceitem entity @p slot.inventory.1 minecraft:arrow 8"):
            self.s.cmd(c)
        self.s.call("/scale", {"n": gui_scale})
        self.f("guiFont", "minecraft")
        self.f("guiAccent", HL_ACCENT)
        for name in HL_OTHER_FIELDS[:7]:
            self.f(name, False)
        self.s.call("/invoke", post={"path": self.cfg + ".setHudSize", "args": "1"})
        for i in self.ids:
            self.f(HL_LAYOUT[i] + "Anchor", -1)
            self.f(HL_LAYOUT[i] + "Scale", 1.0)
            self.bg(i, True)
        self.all_off()
        self.s.call("/close")
        time.sleep(10.5)  # command lines in chat fade
        self.sf = (self.s.status() or {}).get("scaleFactor") or gui_scale

    def all_off(self):
        for g in self.groups:
            self.f(g[1], False)

    def only(self, group):
        self.all_off()
        self.f(group[1], True)

    def shot(self, tag):
        time.sleep(0.35)
        return self.s.shot("hl-" + tag)[1]

    def enter_world(self):
        require_smoke_save(self.s.call("/world", timeout=120))
        for _ in range(90):
            st = api_quiet("/status") or {}
            if st.get("inWorld") and st.get("responsive"):
                break
            time.sleep(1)
        self.s.call("/close")
        time.sleep(2)


def hl_ring_ok(on, none, box, inset=1):
    pts = ring(box, inset)
    bad = [p for p in pts if not see_through_ok(px(on, *p), px(none, *p))]
    return pts and not bad, "%d/%d ring px off the 0x6F ratio" % (len(bad), len(pts))


def hl_bare_ok(img, none, pts, tol=1):
    bad = [p for p in pts if max(abs(a - b) for a, b in zip(px(img, *p), px(none, *p))) > tol]
    return not bad, "%d/%d px differ from the backdrop" % (len(bad), len(pts))


def hl_cap_points(box, sf):
    """One pixel inside each Keystrokes cap's top-left corner (no letter there), kept only if inside box."""
    pts = [(box[0] + int(round(c[0] * sf)) + 1, box[1] + int(round(c[1] * sf)) + 1) for c in HL_CAPS]
    return [p for p in pts if inside((p[0], p[1], p[0], p[1]), box)]


def hl_expected_panel(group, sf):
    """Panel size in screenshot px for the modules whose content size is fixed here, else None."""
    pad2 = 2 * HL_PAD
    if group == "armor":
        return ((16 + pad2) * sf, (16 + pad2) * sf)
    if group == "inventory":
        return ((9 * 22 + 2 + pad2) * sf, (3 * 22 + 2 + pad2) * sf)
    if group == "potion":  # Speed II, 0:45
        return ((18 + 3 + max(vanilla_width("Speed II"), vanilla_width("0:45")) - 1 + pad2) * sf, (18 + pad2) * sf)
    if group == "keystrokes":
        return (56 * sf, 67 * sf)
    if group == "cps":  # no clicks
        return (hl_text_box_width(["0", "0", " CPS"], True) * sf, 18 * sf)
    if group == "ping":  # singleplayer
        return (hl_text_box_width(["--", " ms"]) * sf, 18 * sf)
    return None


def hl_bg(h):
    s = h.s
    s.begin("HL-bg", "Background On: Lunar 0x6F panel; Off: no fill, content still drawn (per module)")
    h.boxes = {}
    for g in h.groups:
        name, _, _, kind = g
        h.all_off()
        s.cmd("/effect @p clear")
        if name == "potion":
            s.cmd("/effect @p 1 45 1 true")
        s.call("/close")
        none = h.shot(name + "-none")
        h.only(g)
        on = h.shot(name + "-on")
        h.group_bg(g, False)
        off = h.shot(name + "-off")
        h.group_bg(g, True)
        on_box, off_box = bbox_diff(none, on), bbox_diff(none, off)
        h.boxes[name] = on_box
        if not s.check(name + ": drawn with its Background on", on_box is not None, on_box):
            continue
        panels = changed_runs(none, on, on_box, "x") if name == "timers" else [on_box]
        if name == "timers":
            if len(panels) < 2:
                panels = changed_runs(none, on, on_box, "y")
            s.check("timers: two panels", len(panels) == 2, panels)
        want = hl_expected_panel(name, h.sf)
        if want:
            got = box_size(on_box)
            s.check(name + ": panel/box %sx%s px (+-1)" % want,
                    abs(got[0] - want[0]) <= 1 and abs(got[1] - want[1]) <= 1, got)
        if kind == "keys":
            pts = hl_cap_points(on_box, h.sf)
            bad = [p for p in pts if not see_through_ok(px(on, *p), px(none, *p))]
            s.check("keystrokes: every idle cap is 0x6F black", len(pts) == 7 and not bad, (len(pts), bad))
            ok, why = hl_bare_ok(off, none, pts)
            s.check("keystrokes Off: no cap fill", ok, why)
            s.check("keystrokes On: letters have no shadow", count_exact(on, on_box, HL_SHADOW) == 0)
            s.check("keystrokes Off: letters have a shadow", count_exact(off, on_box, HL_SHADOW) >= 10)
            continue
        for p in panels:
            ok, why = hl_ring_ok(on, none, p)
            s.check(name + ": panel ring is see-through black (not 0xD0121212)", ok, why)
            if kind != "textbox":
                ok, why = hl_bare_ok(off, none, ring(p, 1))
                s.check(name + " Off: no fill on that ring", ok, why)
        if kind != "textbox":
            s.check(name + " Off: drawn inside the On panel only", inside(off_box, grow(on_box, 1)), off_box)
            if off_box and name not in ("armor", "inventory"):
                margins = (off_box[0] - on_box[0], off_box[1] - on_box[1], on_box[2] - off_box[2], on_box[3] - off_box[3])
                s.check(name + ": the panel pads the content", min(margins) >= (HL_PAD - 1) * h.sf, margins)
        content = (on_box[0] + HL_PAD * h.sf, on_box[1] + HL_PAD * h.sf, on_box[2] - HL_PAD * h.sf, on_box[3] - HL_PAD * h.sf)
        if kind in ("text", "textbox"):
            for tag, img, box in (("On", on, on_box), ("Off", off, off_box or on_box)):
                n = count_exact(img, box, HL_SHADOW)
                s.check("%s %s: white text with its shadow" % (name, tag), n >= 10, n)
        elif kind == "armor":
            icon = (content[0], content[1], content[0] + 16 * h.sf - 1, content[1] + 16 * h.sf - 1)
            area = (16 * h.sf) ** 2
            for tag, img in (("On", on), ("Off", off)):
                frac, _ = diff(none, img, step=1, thresh=6, box=(icon[0], icon[1], icon[2] + 1, icon[3] + 1))
                s.check("armor %s: leggings icon drawn" % tag, frac >= 0.5, "%.2f of %d px" % (frac, area))
        elif kind == "inventory":
            for slot, count in ((0, "4"), (1, "8")):
                tile = (content[0] + (2 + 22 * slot) * h.sf, content[1] + 2 * h.sf,
                        content[0] + (2 + 22 * slot + 20) * h.sf - 1, content[1] + 22 * h.sf - 1)
                for tag, img in (("On", on), ("Off", off)):
                    frac, _ = diff(none, img, step=1, thresh=6, box=(tile[0], tile[1], tile[2] + 1, tile[3] + 1))
                    s.check("inventory %s: item in slot %d" % (tag, slot + 1), frac > 0.2, "%.2f" % frac)
                    n = count_exact(img, tile, HL_SHADOW)
                    s.check("inventory %s: stack count %s with its shadow" % (tag, count), n >= 4, n)
    s.cmd("/effect @p clear")
    h.all_off()


def hl_persist(h):
    s = h.s
    s.begin("HL-persist", "a Background Off survives a restart")
    h.bg("potion", False)
    h.save_config()
    h.restart_game()
    h.enter_world()
    after = h.bg("potion")
    s.check("potion Background still Off after the restart", after is False, after)
    h.bg("potion", True)
    h.save_config()
    h.setup()


def hl_potion(h):
    s = h.s
    s.begin("HL-potion", "Lunar potion rows: 20 px pitch, white name, gray m:ss, under 10 s blinks")
    g = HL_GROUPS[0]
    h.all_off()
    s.cmd("/effect @p clear")
    s.call("/close")
    none = h.shot("potion-none")
    for c in ("/effect @p 1 45 1 true", "/effect @p 8 45 4 true", "/effect @p 14 9 0 true"):
        s.cmd(c)
    s.call("/close")
    h.only(g)
    frames = []
    for i in range(4):
        frames.append(h.shot("potion-rows-%d" % i))
        time.sleep(0.25)
    box = None
    for f in frames:
        b = bbox_diff(none, f)
        if b is None:
            continue
        box = b if box is None else (min(box[0], b[0]), min(box[1], b[1]), max(box[2], b[2]), max(box[3], b[3]))
    if not s.check("potion panel drawn", box is not None, box):
        return
    sf = h.sf
    s.check("panel height (58 + 6) x sf", abs(box_size(box)[1] - 64 * sf) <= 1, box_size(box))
    x0 = box[0] + (HL_PAD + 21) * sf
    top = box[1] + HL_PAD * sf

    def band(row, dy0, dy1):
        return (x0, top + (row * 20 + dy0) * sf, box[2], top + (row * 20 + dy1) * sf - 1)
    third = [count_exact(f, band(2, 1, 10), HL_WHITE) for f in frames]
    s.check("row 3 (9 s left) blinks: present and absent across shots", max(third) > 0 and min(third) == 0, third)
    for row in (0, 1):
        names = [count_exact(f, band(row, 1, 10), HL_WHITE) for f in frames]
        times = [count_exact(f, band(row, 10, 19), HL_GRAY) for f in frames]
        s.check("row %d: white name in every shot" % (row + 1), min(names) > 0, names)
        s.check("row %d: gray time in every shot" % (row + 1), min(times) > 0, times)
    s.cmd("/effect @p clear")
    h.all_off()


def hl_mapinfo(h):
    s = h.s
    s.begin("HL-mapinfo", "Map Info: labels in the accent, values white")
