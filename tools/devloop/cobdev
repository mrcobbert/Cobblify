        jvm = common + ["-Dfabric.gameVersion=1.8.9", "-Dfabric.fixPackageAccess=true",
                        "-Dfabric.modsFolder=" + mods, "-Djava.library.path=" + m.stage(natives[0])]
        main = KNOT
        prog = ["--username", "CobblifyDev", "--version", "1.8.9", "--accessToken", "0", "--userProperties", "{}",
                "--assetsDir", m.stage(assets), "--assetIndex", index, "--width", "1280", "--height", "720"]
        classes_dir, resources_dir = "", ""

    write_text(os.path.join(launch, "java.txt"), JAVA_HOME + "/bin/java\n")
    write_text(os.path.join(launch, "mode.txt"), mode + "\n")
    write_text(os.path.join(launch, "classpath.txt"), "\n".join(classpath) + "\n")
    write_text(os.path.join(launch, "jvm.args"), "\n".join(jvm) + "\n")
    write_text(os.path.join(launch, "args.txt"), "".join(a + "\n" for a in prog))
    write_text(os.path.join(launch, "main.txt"), main + "\n")
    write_text(os.path.join(launch, "addmods.txt"), bridge + "\n")
