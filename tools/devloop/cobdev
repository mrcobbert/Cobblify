    if not cfg:
        return None
    for n in names:
        r, _ = s.try_call("/field", post={"path": cfg + "." + n})
        if r is not None:
            return cfg + "." + n
    return None


def parse_mod_list(lines):
    """Fabric Loader's "Loading N mods:" block: top-level ("- id ver") and nested ("|-- id ver") entries."""
    for i, line in enumerate(lines):
        if re.search(r"Loading \d+ mods:", line):
            ids = []
            for entry in lines[i + 1:]:
                m = re.match(r"^\t[\s|]*(?:[|\\]--|-) (\S+) ", entry)
                if not m:
                    break
                ids.append(m.group(1))
            return line.strip(), ids
    return None, []


def close_enough(a, b, tol):
    return a is not None and b is not None and abs(a - b) <= tol


def smoke_boot(s, mode, fresh):
    s.begin("A3", "boot to title (%s mode): mods, ready line, no mixin errors" % mode)
    st = s.status()
    s.check("ready and responsive", st.get("ready") and st.get("responsive"), st.get("reason"))
    if fresh or not st.get("inWorld"):
        s.check("title screen reached", st.get("title") is True, st.get("screen"))
