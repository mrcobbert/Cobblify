    s.check("fpsHudX moved by ~50 (snap allowed)", x1 is not None and abs((x1 - x0) - 50) <= 8, (x0, x1))
    rx, ry = (x1 or 90) + w - 1, 60 + 17
    s.call("/down", {"x": rx, "y": ry})
