def smoke_hurt(s, cfg):
    s.begin("A6", "No Hurt Cam: horizon tilt within the hurt window")
    s.cmd("/tp @p ~ ~ ~ 0 0")
    time.sleep(1)
    _, level = s.shot("level", wait=200)
    t0 = tilt(level)
    s.check("level frame has a horizon", t0 is not None and abs(t0) <= 3, "tilt %s px" % t0)
    if t0 is None:
        return
    nhc = find_field(s, cfg, NO_HURT_CAM_FIELDS)

    def rolled(t):  # against the level frame, not 0, so any fixed offset cancels out
        return t is not None and abs(t - t0) > 6

    def probe_tilt(tag):
        s.probe("hurt")
        _, img = s.shot(tag, wait=0)
        return tilt(img)

    def real_damage_tilt(tag):
        """Instant Damage I in survival; shoot as soon as the client sees the hit (hurtTime > 0)."""
        s.cmd("/effect @p 6 1 5")
        time.sleep(1.2)
        s.call("/command", post={"command": "/effect @p 7 1 0"})
        hurt = 0
        for _ in range(40):
            hurt = s.probe("player")["client"]["hurtTime"]
            if hurt > 0:
                break
            time.sleep(0.02)
        _, img = s.shot(tag, wait=0)
        return tilt(img), hurt

    if nhc:
        s.field(nhc, False)
    t_off = probe_tilt("hurt-cam-on")
    s.check("probe hurt tilts the camera (No Hurt Cam off%s)" % ("" if nhc else "; vanilla"), rolled(t_off),
            "tilt %s px, level %s" % (t_off, t0))
    s.cmd("/gamemode 0")
    t_real, hurt = real_damage_tilt("real-damage-cam-on")
    s.check("real damage tilts too (cross-check)", hurt > 0 and rolled(t_real),
            "tilt %s px, level %s, hurtTime %s" % (t_real, t0, hurt))
    if not nhc:
        s.cmd("/effect @p 6 1 5")
        s.cmd("/gamemode 1")
        return s.unavailable("No Hurt Cam setting not found (%s); vanilla tilt checked above" % "/".join(NO_HURT_CAM_FIELDS))
    s.field(nhc, True)
    t_real_on, hurt_on = real_damage_tilt("real-damage-cam-off")
    s.check("No Hurt Cam on: real damage, no tilt", hurt_on > 0 and t_real_on is not None and abs(t_real_on - t0) <= 3,
            "tilt %s px, level %s, hurtTime %s" % (t_real_on, t0, hurt_on))
    s.cmd("/effect @p 6 1 5")
    s.cmd("/gamemode 1")
    time.sleep(1)
    t_on = probe_tilt("hurt-cam-off")
    s.check("No Hurt Cam on: probe hurt, no tilt", t_on is not None and abs(t_on - t0) <= 3,
            "tilt %s px, level %s" % (t_on, t0))
    s.field(nhc, False)


