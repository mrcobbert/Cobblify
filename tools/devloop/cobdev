TU_ID = "teamupgrades"
HOTBAR_W, HOTBAR_ZONE_H = 182, 50  # BedwarsHudRenderer's reserved hotbar/health/food zone, GUI px


def tu_boxes(s):
    """probe hud-boxes: (gui width, gui height, {id: box}) with every module's Edit HUD box in GUI px."""
    r = s.probe("hud-boxes")
    gw, gh = r["gui"]
    return gw, gh, {b["id"]: b for b in r["boxes"]}


def tu_box_diff(a, b, box, gw):
    """Changed fraction inside one GUI-px box (screenshot px = GUI px x the screenshot's width / gui width)."""
    w, h, _ = a
    k = w / float(gw)
    x0, y0 = max(0, int(box["x"] * k)), max(0, int(box["y"] * k))
    x1, y1 = min(w, int((box["x"] + box["w"]) * k)), min(h, int((box["y"] + box["h"]) * k))
    return diff(a, b, box=(x0, y0, x1, y1))


def boxes_overlap(a, b):
    return a["x"] < b["x"] + b["w"] and b["x"] < a["x"] + a["w"] and a["y"] < b["y"] + b["h"] and b["y"] < a["y"] + a["h"]


def tu_layout_overlaps(gw, gh, boxes):
    """(what Team Upgrades overlaps: switched-on modules and the hotbar zone; overlaps among the others)."""
    zone = {"id": "hotbar", "x": (gw - HOTBAR_W) / 2.0, "y": gh - HOTBAR_ZONE_H, "w": HOTBAR_W, "h": HOTBAR_ZONE_H}
    shown = [b for b in boxes.values() if b.get("shown") and b["id"] != TU_ID]
    tu = boxes.get(TU_ID)
    mine = [o["id"] for o in shown + [zone] if tu and boxes_overlap(tu, o)]
    others = ["%s/%s" % (a["id"], b["id"]) for i, a in enumerate(shown) for b in shown[i + 1:] if boxes_overlap(a, b)]
    return mine, others


LAYOUT_EDGE, LAYOUT_GAP = 2.0, 2.0  # BedwarsHudRenderer's HudLayout edge and gap, GUI px


def tu_free_place(gw, gh, boxes, w, h):
    """A free, on-screen place for a w x h box clear of every switched-on module but Team Upgrades and of the
    hotbar zone (with HudLayout's edge and gap), or None: the same left/top-edge search as HudLayout.fit."""
    zone = {"id": "hotbar", "x": (gw - HOTBAR_W) / 2.0, "y": gh - HOTBAR_ZONE_H, "w": HOTBAR_W, "h": HOTBAR_ZONE_H}
    taken = [b for b in boxes.values() if b.get("shown") and b["id"] != TU_ID] + [zone]
    e, g = LAYOUT_EDGE, LAYOUT_GAP
    xs = [e, gw - e - w] + [b["x"] + b["w"] + g for b in taken] + [b["x"] - g - w for b in taken]
    ys = [e, gh - e - h] + [b["y"] + b["h"] + g for b in taken] + [b["y"] - g - h for b in taken]
    for x in xs:
        for y in ys:
            if x < e - 0.01 or y < e - 0.01 or x + w > gw - e + 0.01 or y + h > gh - e + 0.01:
                continue
            if not any(x < b["x"] + b["w"] + g and b["x"] < x + w + g and y < b["y"] + b["h"] + g
                       and b["y"] < y + h + g for b in taken):
                return [x, y]
    return None


def tu_save(s, cfg):
    """Write the restored settings to disk: closing Edit HUD saves the config, so values switched on for a
    check would otherwise outlive the step (the next restart loads them)."""
    s.try_call("/invoke", post={"path": cfg + ".save", "args": ""})


def tu_quiet_chat(s):
