# the accent, Lunar Keystrokes caps, and the FPS / CPS / Ping modules. Boxes are found from frame diffs (no bridge
# change); every box below is (x0, y0, x1, y1) in screenshot px, both ends inclusive, as diff() reports them.

HL_FILL_ALPHA = 0x6F                       # HudBackground.FILL = 0x6F000000
HL_SHADOW = (63, 63, 63)                   # vanilla shadow of white text
HL_WHITE = (255, 255, 255)
HL_GRAY = (170, 170, 170)                  # potion time, CPS divider
HL_DIVIDER_SHADOW = (42, 42, 42)
HL_PRESSED_TEXT = (18, 18, 18)             # KeyCapStyle: dark letter on a pale accent
HL_ACCENT = "pale-blue"
HL_ACCENT_RGB = (192, 220, 255)            # GuiTheme PALE_BLUE 0xFFC0DCFF
HL_PAD = 3                                 # HudBackground.pad(1) = CONTENT_MARGIN, GUI px
HL_TIME_DY = 10                            # PotionRows.TIME_DY: the time line's top in a potion row
ICONS = "com.bedwarsqol.hud.EffectIconTextures"

# Vanilla 1.8.9 font advances (glyph + 1 px column), as the unit tests use them.
_NARROW = {" ": 4, "!": 2, "\"": 5, "'": 3, "(": 5, ")": 5, "*": 5, ",": 2, ".": 2, ":": 2, ";": 2, "<": 5,
           ">": 5, "@": 7, "I": 4, "[": 4, "]": 4, "`": 3, "f": 5, "i": 2, "k": 5, "l": 3, "t": 4, "{": 5,
           "|": 2, "}": 5, "~": 7}


def vanilla_width(text):
    return sum(_NARROW.get(c, 6) for c in text)


def ring(box, inset):
    """Points on the rectangle `inset` px inside box, each once; [] when the box is too small."""
    x0, y0, x1, y1 = box[0] + inset, box[1] + inset, box[2] - inset, box[3] - inset
    if x1 < x0 or y1 < y0:
        return []
    pts = [(x, y0) for x in range(x0, x1 + 1)]
    if y1 > y0:
        pts += [(x, y1) for x in range(x0, x1 + 1)]
    pts += [(x0, y) for y in range(y0 + 1, y1)]
    if x1 > x0:
        pts += [(x1, y) for y in range(y0 + 1, y1)]
    return pts


def see_through_ok(on_px, off_px, alpha=HL_FILL_ALPHA, tol=2):
    """Is on_px the backdrop off_px under black at `alpha`? (each channel round(c * (1 - alpha/255)) +- tol)"""
    return all(abs(a - round(b * (1 - alpha / 255.0))) <= tol for a, b in zip(on_px, off_px))


def count_exact(img, box, rgb):
    x0, y0, x1, y1 = box
    return sum(1 for y in range(y0, y1 + 1) for x in range(x0, x1 + 1) if px(img, x, y) == tuple(rgb))


def count_near(img, box, rgb, tol):
    x0, y0, x1, y1 = box
    return sum(1 for y in range(y0, y1 + 1) for x in range(x0, x1 + 1)
               if max(abs(c - t) for c, t in zip(px(img, x, y), rgb)) <= tol)


def xs_of(img, box, rgb):
    """(min x, max x) of the pixels exactly rgb in box, or None."""
    xs = [x for y in range(box[1], box[3] + 1) for x in range(box[0], box[2] + 1) if px(img, x, y) == tuple(rgb)]
    return (min(xs), max(xs)) if xs else None


def ys_of(img, box, rgb):
    ys = [y for y in range(box[1], box[3] + 1) for x in range(box[0], box[2] + 1) if px(img, x, y) == tuple(rgb)]
    return (min(ys), max(ys)) if ys else None


def changed_points(a, b, box=None, thresh=6):
    """Pixels (x, y) inside box that differ by more than thresh in a channel; rows that are identical are skipped
    whole, so a frame where only the HUD changed is scanned quickly. None when the frames differ in size."""
    w, h, ra = a
    if (w, h) != b[:2]:
        return None
    rb = b[2]
    x0, y0, x1, y1 = box or (0, 0, w - 1, h - 1)
    x0, y0, x1, y1 = max(0, x0), max(0, y0), min(w - 1, x1), min(h - 1, y1)
    out = []
    for y in range(y0, y1 + 1):
        sa, sb = ra[y][3 * x0:3 * x1 + 3], rb[y][3 * x0:3 * x1 + 3]
        if sa == sb:
            continue
        for i in range(0, len(sa), 3):
            if sa[i:i + 3] != sb[i:i + 3] and max(abs(sa[i] - sb[i]), abs(sa[i + 1] - sb[i + 1]),
                                                  abs(sa[i + 2] - sb[i + 2])) > thresh:
                out.append((x0 + i // 3, y))
    return out


def bbox_of(points):
    if not points:
        return None
    xs, ys = [p[0] for p in points], [p[1] for p in points]
    return (min(xs), min(ys), max(xs), max(ys))


def bbox_diff(a, b, box=None, thresh=6):
    """Exact bounding box of the pixels that differ between two frames (every pixel, unlike diff())."""
    pts = changed_points(a, b, box, thresh)
    return bbox_of(pts) if pts is not None else None


def hud_clusters(a, b, box=None, thresh=6, cell=4, join=3, also=None):
    """The changed pixels grouped into clusters: cells of `cell` px, joined across gaps of up to `join` cells.
    `also` is a second backdrop (taken after the frame): a pixel counts only if b differs from both, so a world
    pixel that changed once, before or after the frame, does not. Returns [(points, bbox)], biggest first."""
    pts = changed_points(a, b, box, thresh) or []
    if also is not None:
        other = set(changed_points(also, b, box, thresh) or [])
        pts = [p for p in pts if p in other]
    cells = {}
    for p in pts:
        cells.setdefault((p[0] // cell, p[1] // cell), []).append(p)
    seen, out = set(), []
    for start in cells:
        if start in seen:
            continue
        seen.add(start)
        stack, members = [start], []
        while stack:
            c = stack.pop()
            members.extend(cells[c])
            for dx in range(-join, join + 1):
                for dy in range(-join, join + 1):
                    n = (c[0] + dx, c[1] + dy)
                    if n in cells and n not in seen:
                        seen.add(n)
                        stack.append(n)
        out.append((members, bbox_of(members)))
    return sorted(out, key=lambda m: -len(m[0]))


def hud_boxes(a, b, box=None, thresh=6, min_px=12, max_frac=0.75, also=None):
    """Bounding boxes of the HUD changes between two frames, biggest first: the clusters of changed pixels, without
    specks (under min_px: a world pixel that flickered) and bands wider than max_frac of the frame (the horizon and
    far chunks redrawing, a camera that moved)."""
    w = a[0]
    return [bb for members, bb in hud_clusters(a, b, box, thresh, also=also)
            if len(members) >= min_px and box_size(bb)[0] < max_frac * w]


def hud_bbox(a, b, box=None, thresh=6, min_px=12, max_frac=0.75, also=None):
    """The biggest HUD change (hud_boxes), or None."""
    found = hud_boxes(a, b, box, thresh, min_px, max_frac, also)
    return found[0] if found else None


def union_box(boxes):
    boxes = [b for b in boxes if b]
    if not boxes:
        return None
    return (min(b[0] for b in boxes), min(b[1] for b in boxes), max(b[2] for b in boxes), max(b[3] for b in boxes))


def world_changes(a, b, keep, thresh=6):
    """Changed pixels outside the box `keep` (the module and its margin): the scene itself moved when this is big."""
    pts = changed_points(a, b, None, thresh) or []
    return sum(1 for p in pts if not inside((p[0], p[1], p[0], p[1]), keep))


def changed_runs(a, b, box, axis, thresh=6):
    """Sub-boxes of box split at the columns (axis "x") or rows ("y") where nothing changed."""
    x0, y0, x1, y1 = box
    lines = range(x0, x1 + 1) if axis == "x" else range(y0, y1 + 1)

    def hit(i):
        cells = ((i, y) for y in range(y0, y1 + 1)) if axis == "x" else ((x, i) for x in range(x0, x1 + 1))
        return any(max(abs(p - q) for p, q in zip(px(a, x, y), px(b, x, y))) > thresh for x, y in cells)
    runs, start = [], None
    for i in lines:
        if hit(i):
            start = i if start is None else start
        elif start is not None:
            runs.append((start, i - 1))
            start = None
    if start is not None:
        runs.append((start, lines[-1]))
    out = []
    for lo, hi in runs:
        sub = (lo, y0, hi, y1) if axis == "x" else (x0, lo, x1, hi)
        tight = bbox_diff(a, b, sub, thresh)
        if tight:
            out.append(tight)
    return out


def inside(inner, outer):
    return (inner is not None and outer is not None and inner[0] >= outer[0] and inner[1] >= outer[1]
            and inner[2] <= outer[2] and inner[3] <= outer[3])


def disjoint(boxes):
    for i, a in enumerate(boxes):
        for b in boxes[i + 1:]:
            if a[0] <= b[2] and b[0] <= a[2] and a[1] <= b[3] and b[1] <= a[3]:
                return False
    return True


def grow(box, d):
    return (box[0] - d, box[1] - d, box[2] + d, box[3] + d)


def box_size(box):
    return (box[2] - box[0] + 1, box[3] - box[1] + 1) if box else (0, 0)


def hl_text_box_width(segments, divider=False):
    """TextModules.boxWidth with vanilla advances: text minus its trailing column, plus 4 px each side."""
    return sum(vanilla_width(t) for t in segments) + (7 if divider else 0) - 1 + 8


