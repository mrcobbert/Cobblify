    missing += [pin_path(p["name"]) for p in PINS if not os.path.exists(pin_path(p["name"]))]
    if missing:
        die("not set up yet (missing %s); run: tools/devloop/cobdev setup" % ", ".join(missing))


def gradle(wt, *args, init=True, extra_props=None):
    cmd = [os.path.join(wt, "ornithe", "gradlew"), "-q"]
    if init:
        cmd += ["--init-script", os.path.join(HERE, "devloop.init.gradle"),
                "-PcobdevBridgeDir=" + os.path.join(HERE, "bridge"),
                "-PcobdevDevMods=" + ",".join(pin_path(p["name"]) for p in pins_for("dev"))]
    cmd += ["-P%s=%s" % kv for kv in (extra_props or {}).items()] + list(args)
    p = subprocess.run(cmd, cwd=os.path.join(wt, "ornithe"), stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                       text=True)
    noise = ("duplicate input class", "WARNING:", "is obsolete", "-Xlint:-options", "warnings")
    out = "\n".join(l for l in p.stdout.splitlines() if not any(n in l for n in noise))
    if p.returncode != 0:
        print(out)
        die("gradle failed")


def runtime_of(classes_dir):
    rel = os.path.relpath(classes_dir, SHARED + "/runtimes")
    if rel.startswith(".."):
        die("the running game was not started from a cobdev runtime: " + classes_dir)
    return os.path.join(SHARED, "runtimes", rel.split(os.sep)[0])


def source_of(runtime):
    with open(os.path.join(runtime, "launch", "source.json")) as f:
        return json.load(f)


def running_runtime(st):
    """Runtime dir of the running game (prod runs have no classes dir; they report their runtime)."""
    if st.get("classesDir"):
        return runtime_of(st["classesDir"])
    return None


def wait_ready(old_pid=None, timeout=240):
    start = time.time()
    while time.time() - start < timeout:
        st = api_quiet("/status")
        if st and st.get("ready") and st.get("responsive") and st.get("pid") != old_pid:
            return time.time() - start
        time.sleep(1)
    die("the game did not come back within %ds. Is start.sh still running in the user's pane?" % timeout)


