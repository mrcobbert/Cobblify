def png_read(data):
    """Minimal PNG decoder for the bridge's own output (8-bit RGB/RGBA, not interlaced)."""
    if data[:8] != b"\x89PNG\r\n\x1a\n":
        raise ValueError("not a PNG")
    pos, idat, w = 8, b"", None
    while pos < len(data):
        length, kind = struct.unpack(">I4s", data[pos:pos + 8])
        body = data[pos + 8:pos + 8 + length]
        if kind == b"IHDR":
            w, h, depth, color, _, _, interlace = struct.unpack(">IIBBBBB", body)
            if depth != 8 or color not in (2, 6) or interlace:
                raise ValueError("unsupported PNG format")
            bpp = 3 if color == 2 else 4
        elif kind == b"IDAT":
            idat += body
        pos += 12 + length
    raw = zlib.decompress(idat)
    stride = w * bpp
    rows, prev = [], bytearray(stride)
    for y in range(h):
        f = raw[y * (stride + 1)]
        line = bytearray(raw[y * (stride + 1) + 1:(y + 1) * (stride + 1)])
        for i in range(stride):
            a = line[i - bpp] if i >= bpp else 0
            b = prev[i]
            c = prev[i - bpp] if i >= bpp else 0
            if f == 1:
                line[i] = (line[i] + a) & 255
            elif f == 2:
                line[i] = (line[i] + b) & 255
            elif f == 3:
                line[i] = (line[i] + ((a + b) >> 1)) & 255
            elif f == 4:
                p = a + b - c
                pa, pb, pc = abs(p - a), abs(p - b), abs(p - c)
                line[i] = (line[i] + (a if pa <= pb and pa <= pc else b if pb <= pc else c)) & 255
        rows.append(bytes(line) if bpp == 3 else bytes(v for i, v in enumerate(line) if i % 4 != 3))
        prev = line
    return w, h, rows


def png_write(w, h, rgb_rows):
    """Tiny encoder (used by the self-test)."""
    raw = b"".join(b"\x00" + bytes(r) for r in rgb_rows)

    def chunk(kind, body):
        return struct.pack(">I", len(body)) + kind + body + struct.pack(">I", zlib.crc32(kind + body) & 0xffffffff)
    return (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
            + chunk(b"IDAT", zlib.compress(raw)) + chunk(b"IEND", b""))


def load_png(path):
    with open(path, "rb") as f:
        return png_read(f.read())


def px(img, x, y):
    w, h, rows = img
    r = rows[y]
    return r[3 * x], r[3 * x + 1], r[3 * x + 2]


def spread(img, step=16):
    """Largest per-channel standard deviation over a sample grid; ~0 for a blank frame."""
    w, h, _ = img
    best = 0.0
    for ch in range(3):
        vals = [px(img, x, y)[ch] for y in range(0, h, step) for x in range(0, w, step)]
        mean = sum(vals) / len(vals)
        best = max(best, (sum((v - mean) ** 2 for v in vals) / len(vals)) ** 0.5)
    return best


def diff(a, b, step=4, thresh=24, box=None):
    """Fraction of sampled pixels that differ, plus their bounding box (x0, y0, x1, y1)."""
    w, h, _ = a
    if (w, h) != b[:2]:
        return 1.0, None
    x0, y0, x1, y1 = box or (0, 0, w, h)
    n = changed = 0
    bb = [w, h, -1, -1]
    for y in range(y0, y1, step):
        for x in range(x0, x1, step):
            n += 1
            pa, pb = px(a, x, y), px(b, x, y)
            if max(abs(pa[0] - pb[0]), abs(pa[1] - pb[1]), abs(pa[2] - pb[2])) > thresh:
                changed += 1
                bb = [min(bb[0], x), min(bb[1], y), max(bb[2], x), max(bb[3], y)]
    return (changed / n if n else 0.0), (tuple(bb) if bb[2] >= 0 else None)


def horizon_row(img, x):
    """Sky-to-ground boundary in column x: first row (from the top) whose blueness drops below half the sky's."""
    w, h, _ = img
    top = px(img, x, int(h * 0.15))
    sky = top[2] - top[1]
    if sky < 20:
        return None
    for y in range(int(h * 0.15), int(h * 0.9)):
        p = px(img, x, y)
        if p[2] - p[1] < sky / 2:
            return y
    return None


def _median(vals):
    vals = sorted(v for v in vals if v is not None)
    return vals[len(vals) // 2] if vals else None


def tilt(img):
    """Horizon height on the left (x 15-40%) minus the right (x 60-85%), each a median over six
    columns so a HUD element over one column cannot fake a tilt; 0 when the camera is level."""
    w, _, _ = img
    left = _median(horizon_row(img, int(w * f / 100)) for f in range(15, 41, 5))
    right = _median(horizon_row(img, int(w * f / 100)) for f in range(60, 86, 5))
    return None if left is None or right is None else left - right


