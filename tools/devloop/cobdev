def smoke_clutch(s, cfg):
    s.begin("A2-clutch", "Clutch Practice: blast damage/knockback, block filter, damage cap, isolation, fire charge")
    if not s.has("com.bedwarsqol.feature.ClutchPractice") or not cfg:
        return s.unavailable("Clutch Practice is not in this build (Track A port)")
    ready = s.call("/invoke", post={"path": CLUTCH_GET, "args": ""}).get("value")
    if not s.check("ClutchPractice.get() is set (READY reached)", ready is not None, ready):
        return
    cp, bd = cfg + ".clutchPractice", cfg + ".clutchBlockDamage"

    def heal():
        s.cmd("/effect @p 6 1 5")
        time.sleep(1.2)  # outlast hurtResistantTime

    def place(dx, dy, dz, block):
        """Places relative to the feet now; returns the absolute position for reads after the blast."""
        return s.probe("block", dx, dy, dz, block)["pos"]

    def read(pos):
        return s.probe("block", "at", *pos)["block"]

    # Health must only change through the checks below (no natural regeneration in between).
    s.cmd("/gamerule naturalRegeneration false")
    s.field(cp, True)
    s.field(bd, False)
    s.cmd("/gamemode 0")
    s.cmd("/tp @p ~ ~ ~ 0 0")
    heal()
    r = s.probe("clutch-blast", 3, 0, 0)
    drop = r["before"]["health"] - r["after"]["health"]
    s.check("health drops by ClutchRules.damage(distance) once", close_enough(drop, r.get("expectedDamage"), 0.01),
            "drop %.3f, expected %s" % (drop, r.get("expectedDamage")))
    exp = r.get("expectedKnockback")
    s.check("motion equals ClutchRules.knockback", exp and all(close_enough(a, b, 1e-6) for a, b in zip(r["after"]["motion"], exp)),
            "motion %s, expected %s" % (r["after"]["motion"], exp))
    time.sleep(0.5)
    later = s.probe("player")["server"]["health"]
    s.check("no extra (vanilla) explosion damage afterwards", later >= r["after"]["health"] - 0.01,
            "%.3f then %.3f" % (r["after"]["health"], later))
    for on in (True, False):
        heal()
        s.field(bd, on)
        # Absolute positions, captured before the blast moves the player (review I3).
        wool_at = place(3, 0, 1, "minecraft:wool")
        stone_at = place(3, 0, -1, "minecraft:stone")
        time.sleep(0.2)
        s.probe("clutch-blast", 3, 0, 0)
        time.sleep(0.2)
        wool, stone = read(wool_at), read(stone_at)
        label = "on" if on else "off"
        if on:
            s.check("Block Damage on: wool breaks", wool == "minecraft:air", "%s at %s" % (wool, wool_at))
        else:
            s.check("Block Damage off: wool stays", wool == "minecraft:wool", "%s at %s" % (wool, wool_at))
        s.check("Block Damage %s: stone stays" % label, stone == "minecraft:stone", "%s at %s" % (stone, stone_at))
    s.field(bd, False)
    # Low health (review I4): Instant Damage I (6) three times takes 20 -> 2, so an uncapped 2-point
    # blast would kill. (Duration 0 would remove the effect instead of applying it.)
    heal()
    for _ in range(3):
        s.cmd("/effect @p 7 1 0")
        time.sleep(1.2)
    low = s.probe("clutch-blast", 3, 0, 0)
    before, after = low["before"]["health"], low["after"]["health"]
    dmg = low.get("expectedDamage") or 0
    s.check("health is low enough that an uncapped blast would kill", 0 < before <= dmg,
            "health %.2f, blast damage %s" % (before, dmg))
    s.check("low health: the hit leaves >= half a heart", after >= 1.0 - 1e-6, "%.2f -> %.2f" % (before, after))
    heal()
    # Isolation (plan R1-I3): with Clutch Practice on and Block Damage off, an ordinary TNT blast
    # stays vanilla: it still breaks blocks and still deals its own damage.
    s.field(cp, True)
    s.field(bd, False)
    tnt_stone = place(4, 0, 0, "minecraft:stone")
    s.cmd("/summon PrimedTnt ~5 ~ ~ {Fuse:0}")
    time.sleep(0.6)
    stone = read(tnt_stone)
    s.check("Clutch on, Block Damage off: an ordinary explosion still breaks stone", stone == "minecraft:air",
            "%s at %s" % (stone, tnt_stone))
    # Damage needs a clear line (the stone above shields the player: exposure is computed before blocks
    # break) and a non-peaceful world (explosions are difficulty-scaled; peaceful deals 0). At 6 blocks
    # with full exposure vanilla TNT deals ~9.8 on Normal, far above Clutch's fixed blast.
    s.cmd("/difficulty 2")
    heal()
    hp = s.probe("player")["server"]["health"]
    s.cmd("/summon PrimedTnt ~ ~ ~6 {Fuse:0}")
    time.sleep(0.6)
    hit = s.probe("player")["server"]["health"]
    s.check("Clutch on: an ordinary explosion deals vanilla damage, not Clutch's", hp - hit > 2.0 + 1e-6,
            "%.2f -> %.2f" % (hp, hit))
    heal()
    u = s.probe("use-item", "minecraft:fire_charge")
    s.check("use-item with a fire charge spawns a Clutch fireball",
            any(c.endswith("ClutchFireball") for c in u.get("spawned", [])), u.get("spawned"))
    s.field(cp, False)
    s.cmd("/gamerule naturalRegeneration true")
    s.cmd("/gamemode 1")
    heal()


