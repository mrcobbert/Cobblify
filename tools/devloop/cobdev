# Keystrokes caps (KeystrokesLayout.CAPS), GUI px from the module's top-left at scale 1.
HL_CAPS = [(19, 0, 18, 18), (0, 19, 18, 18), (19, 19, 18, 18), (38, 19, 18, 18), (0, 57, 56, 10),
           (0, 38, 27.5, 18), (28.5, 38, 27.5, 18)]


class HudLook:
    """State for the HL step: the config paths it touches, their values before it ran, the scale factor."""

    def __init__(self, s, cfg, restart_game):
        self.s, self.cfg, self.restart_game = s, cfg, restart_game
        self.groups = list(HL_GROUPS)
        if find_field(s, cfg, ["teamUpgradesEnabled"]):
            self.groups.append(HL_TEAM_UPGRADES)
        self.ids = [i for g in self.groups for i in g[2]]
        self.fields = [g[1] for g in self.groups] + HL_OTHER_FIELDS
        for i in self.ids:
            self.fields += [HL_LAYOUT[i] + k for k in ("X", "Y", "Anchor", "Scale")]
        self.saved, self.saved_bg, self.saved_gui = {}, {}, None
        self.sf = 2

    def f(self, name, value=None):
        return self.s.field(self.cfg + "." + name, value)

    def bg(self, item, on=None):
        if on is None:
            return self.s.call("/invoke", post={"path": self.cfg + ".hudBackground", "args": item}).get("value")
        self.s.call("/invoke", post={"path": self.cfg + ".setHudBackground", "args": ARG_SEP.join([item, str(on).lower()])})

    def group_bg(self, group, on):
        for item in group[2]:
            self.bg(item, on)

    def save_config(self):
        self.s.try_call("/invoke", post={"path": self.cfg + ".save", "args": ""})

    def snapshot(self):
        for name in self.fields:
            r, _ = self.s.try_call("/field", post={"path": self.cfg + "." + name})
            if r is not None:
                self.saved[name] = r.get("value")
        for i in self.ids:
            self.saved_bg[i] = self.bg(i)
        self.saved_gui = (self.s.status() or {}).get("guiScaleSetting")

    def restore(self):
        for name, value in self.saved.items():
            self.s.try_call("/field", post={"path": self.cfg + "." + name, "value": str(value).lower()
                                            if isinstance(value, bool) else str(value)})
        for i, on in self.saved_bg.items():
            if on is not None:
                self.bg(i, bool(on))
        if self.saved_gui is not None:
            self.s.try_call("/scale", {"n": self.saved_gui})
        self.s.try_call("/field", post={"path": ICONS + ".cacheDirOverride", "value": ""})
        self.save_config()
        self.s.try_call("/command", post={"command": "/gamerule sendCommandFeedback true"})

    def setup(self, gui_scale=2):
        """The fixed scene: noon, clear, looking north from a known spot, one item stack each in main slots 9-10."""
        for c in ("/gamerule sendCommandFeedback false", "/gamerule doDaylightCycle false", "/time set 6000",
                  "/weather clear", "/tp @p 0.5 4 0.5 0 0", "/effect @p clear",
                  "/replaceitem entity @p slot.armor.legs minecraft:diamond_leggings",
                  "/replaceitem entity @p slot.inventory.0 minecraft:diamond 4",
                  "/replaceitem entity @p slot.inventory.1 minecraft:arrow 8"):
            self.s.cmd(c)
        self.s.call("/scale", {"n": gui_scale})
        self.f("guiFont", "minecraft")
        self.f("guiAccent", HL_ACCENT)
        for name in HL_OTHER_FIELDS[:7]:
            self.f(name, False)
        self.s.call("/invoke", post={"path": self.cfg + ".setHudSize", "args": "1"})
        for i in self.ids:
            self.f(HL_LAYOUT[i] + "Anchor", -1)
            self.f(HL_LAYOUT[i] + "Scale", 1.0)
            self.bg(i, True)
        self.all_off()
        self.s.call("/close")
        time.sleep(10.5)  # command lines in chat fade
        self.sf = (self.s.status() or {}).get("scaleFactor") or gui_scale

    def all_off(self):
        for g in self.groups:
            self.f(g[1], False)

    def only(self, group):
        self.all_off()
        self.f(group[1], True)

    def shot(self, tag):
        time.sleep(0.35)
        return self.s.shot("hl-" + tag)[1]

    def enter_world(self):
        require_smoke_save(self.s.call("/world", timeout=120))
        for _ in range(90):
            st = api_quiet("/status") or {}
            if st.get("inWorld") and st.get("responsive"):
                break
            time.sleep(1)
        self.s.call("/close")
        time.sleep(2)


def hl_ring_ok(on, none, box, inset=1):
    pts = ring(box, inset)
    bad = [p for p in pts if not see_through_ok(px(on, *p), px(none, *p))]
    return pts and not bad, "%d/%d ring px off the 0x6F ratio" % (len(bad), len(pts))


def hl_bare_ok(img, none, pts, tol=1):
    bad = [p for p in pts if max(abs(a - b) for a, b in zip(px(img, *p), px(none, *p))) > tol]
    return not bad, "%d/%d px differ from the backdrop" % (len(bad), len(pts))


def hl_cap_points(box, sf):
    """One pixel inside each Keystrokes cap's top-left corner (no letter there), kept only if inside box."""
    pts = [(box[0] + int(round(c[0] * sf)) + 1, box[1] + int(round(c[1] * sf)) + 1) for c in HL_CAPS]
    return [p for p in pts if inside((p[0], p[1], p[0], p[1]), box)]


def hl_expected_panel(group, sf):
    """Panel size in screenshot px for the modules whose content size is fixed here, else None."""
    pad2 = 2 * HL_PAD
    if group == "armor":
        return ((16 + pad2) * sf, (16 + pad2) * sf)
    if group == "inventory":
        return ((9 * 22 + 2 + pad2) * sf, (3 * 22 + 2 + pad2) * sf)
    if group == "potion":  # Speed II, 0:45
        return ((18 + 3 + max(vanilla_width("Speed II"), vanilla_width("0:45")) - 1 + pad2) * sf, (18 + pad2) * sf)
    if group == "keystrokes":
        return (56 * sf, 67 * sf)
    if group == "cps":  # no clicks
        return (hl_text_box_width(["0", "0", " CPS"], True) * sf, 18 * sf)
    if group == "ping":  # singleplayer
        return (hl_text_box_width(["--", " ms"]) * sf, 18 * sf)
    return None


HL_ARMOR_ICON_MIN = 0.3   # diamond leggings cover ~44% of their 16 x 16 slot
HL_ITEM_MIN = 0.1         # an arrow covers ~17% of its tile


def hl_scene_moved(none, img, box, sf):
    """Did the world change outside the module (camera turned, a screen opened, the window resized)?"""
    if box is None or img[:2] != none[:2]:
        return img[:2] != none[:2]
    w, hgt, _ = none
    return world_changes(none, img, grow(box, 8 * sf)) > max(400, 0.002 * w * hgt)


def hl_backdrop(img, backdrops, box, sf):
    """Of the backdrops (module off, taken before and after), the one that matches img best outside the module."""
    if box is None:
        return backdrops[0]
    same = [n for n in backdrops if n[:2] == img[:2]] or [backdrops[0]]
    return min(same, key=lambda n: world_changes(n, img, grow(box, 8 * sf)))


def hl_bg_boxes(name, backdrops, on, off, sf):
    """(On box, its panels, Off box): the module's change in each frame, as clusters of the pixels that differ from
    both backdrops, so world specks, the horizon and far chunks redrawing do not count. The gen timers are two
    panels; the Off content is looked for around the On box."""
    before, after = backdrops
    found = hud_boxes(before, on, also=after)
    panels = found[:2] if name == "timers" else found[:1]
    on_box = union_box(panels)
    off_box = union_box(hud_boxes(before, off, grow(on_box, 8 * sf), also=after)) if on_box else None
    return on_box, sorted(panels), off_box


def hl_bg_checks(name, kind, backdrops, on, off, sf):
    """Every HL-bg check for one module from its frames, as (check, ok, detail); its On box; and whether the scene
    moved (then the frames say nothing about the module)."""
    out = []
    on_box, panels, off_box = hl_bg_boxes(name, backdrops, on, off, sf)
    out.append((name + ": drawn with its Background on", on_box is not None, on_box))
    if on_box is None:
        return out, None, False
    none, none_off = hl_backdrop(on, backdrops, on_box, sf), hl_backdrop(off, backdrops, on_box, sf)
    moved = hl_scene_moved(none, on, on_box, sf) or hl_scene_moved(none_off, off, on_box, sf)
    if name == "timers":
        out.append(("timers: two panels", len(panels) == 2, panels))
    want = hl_expected_panel(name, sf)
    if want:
        got = box_size(on_box)
        out.append((name + ": panel/box %sx%s px (+-1)" % want,
                    abs(got[0] - want[0]) <= 1 and abs(got[1] - want[1]) <= 1, got))
    if kind == "keys":
        pts = hl_cap_points(on_box, sf)
        bad = [p for p in pts if not see_through_ok(px(on, *p), px(none, *p))]
        out.append(("keystrokes: every idle cap is 0x6F black", len(pts) == 7 and not bad, (len(pts), bad)))
        ok, why = hl_bare_ok(off, none_off, pts)
        out.append(("keystrokes Off: no cap fill", ok, why))
        out.append(("keystrokes On: letters have no shadow", count_exact(on, on_box, HL_SHADOW) == 0, None))
        out.append(("keystrokes Off: letters have a shadow", count_exact(off, on_box, HL_SHADOW) >= 10, None))
        return out, on_box, moved
    for p in panels:
        ok, why = hl_ring_ok(on, none, p)
        out.append((name + ": panel ring is see-through black (not 0xD0121212)", ok, why))
        if kind != "textbox":
            ok, why = hl_bare_ok(off, none_off, ring(p, 1))
            out.append((name + " Off: no fill on that ring", ok, why))
    if kind != "textbox":
        out.append((name + " Off: drawn inside the On panel only", inside(off_box, grow(on_box, 1)), off_box))
        if off_box and name not in ("armor", "inventory"):
            margins = (off_box[0] - on_box[0], off_box[1] - on_box[1], on_box[2] - off_box[2], on_box[3] - off_box[3])
            out.append((name + ": the panel pads the content", min(margins) >= (HL_PAD - 1) * sf, margins))
    content = (on_box[0] + HL_PAD * sf, on_box[1] + HL_PAD * sf, on_box[2] - HL_PAD * sf, on_box[3] - HL_PAD * sf)
    if kind in ("text", "textbox"):
        for tag, img, box in (("On", on, on_box), ("Off", off, off_box or on_box)):
            n = count_exact(img, box, HL_SHADOW)
            out.append(("%s %s: white text with its shadow" % (name, tag), n >= 10, n))
    elif kind == "armor":
        icon = (content[0], content[1], content[0] + 16 * sf - 1, content[1] + 16 * sf - 1)
        area = (16 * sf) ** 2
        for tag, img, back, least in (("On", on, none, 0.5), ("Off", off, none_off, HL_ARMOR_ICON_MIN)):
            frac = len(changed_points(back, img, icon)) / float(area)
            out.append(("armor %s: leggings icon drawn" % tag, frac >= least, "%.2f of %d px" % (frac, area)))
    elif kind == "inventory":
        for slot, count in ((0, "4"), (1, "8")):
            tile = (content[0] + (2 + 22 * slot) * sf, content[1] + 2 * sf,
                    content[0] + (2 + 22 * slot + 20) * sf - 1, content[1] + 22 * sf - 1)
            area = (20 * sf) ** 2
            for tag, img, back in (("On", on, none), ("Off", off, none_off)):
                frac = len(changed_points(back, img, tile)) / float(area)
                out.append(("inventory %s: item in slot %d" % (tag, slot + 1), frac > HL_ITEM_MIN, "%.2f" % frac))
                n = count_exact(img, tile, HL_SHADOW)
                out.append(("inventory %s: stack count %s with its shadow" % (tag, count), n >= 4, n))
    return out, on_box, moved


def hl_bg(h):
    s = h.s
    s.begin("HL-bg", "Background On: Lunar 0x6F panel; Off: no fill, content still drawn (per module)")
    h.boxes = {}
    for g in h.groups:
        name, _, _, kind = g
        for attempt in range(3):
            # A fixed view, no screen open, a backdrop before and after: real input reaching the window (a turned
            # camera, an opened chat, a resize) changes the whole frame, and then this module's shots are retaken.
            h.all_off()
            s.cmd("/effect @p clear")
            if name == "potion":
                s.cmd("/effect @p 1 45 1 true")
            s.cmd("/tp @p 0.5 4 0.5 0 0")
            s.call("/close")
            time.sleep(0.6)  # the FOV settles after an effect change
            before = h.shot(name + "-none")
            h.only(g)
            on = h.shot(name + "-on")
            h.group_bg(g, False)
            off = h.shot(name + "-off")
            h.group_bg(g, True)
            h.all_off()
            after = h.shot(name + "-none-after")
            checks, on_box, moved = hl_bg_checks(name, kind, (before, after), on, off, h.sf)
            if not moved:
                break
        h.boxes[name] = on_box
        if not s.check(name + ": the scene held still for its shots (else real input reached the game)", not moved):
            continue
        for check, ok, detail in checks:
            s.check(check, ok, detail)
    s.cmd("/effect @p clear")
    h.all_off()


def hl_persist(h):
    s = h.s
    s.begin("HL-persist", "a Background Off survives a restart")
    h.bg("potion", False)
    h.save_config()
    h.restart_game()
    h.enter_world()
    after = h.bg("potion")
    s.check("potion Background still Off after the restart", after is False, after)
    h.bg("potion", True)
    h.save_config()
    h.setup()


def hl_potion(h):
    s = h.s
    s.begin("HL-potion", "Lunar potion rows: 20 px pitch, white name, gray m:ss, under 10 s blinks")
    g = HL_GROUPS[0]
    h.all_off()
    s.cmd("/effect @p clear")
    # The effects first, then the backdrop: Speed widens the field of view and Invisibility hides the hand, so a
    # backdrop taken before them differs from every later frame across the whole screen.
    for c in ("/effect @p 1 45 1 true", "/effect @p 8 45 4 true", "/effect @p 14 9 0 true"):
        s.cmd(c)
    s.cmd("/tp @p 0.5 4 0.5 0 0")
    s.call("/close")
    time.sleep(0.6)  # the FOV settles
    none = h.shot("potion-none")
    h.only(g)
    frames = []
    for i in range(4):
        frames.append(h.shot("potion-rows-%d" % i))
        time.sleep(0.25)
    h.all_off()
    after = h.shot("potion-none-after")
    box = union_box([hud_bbox(none, f, also=after) for f in frames])
    if not s.check("potion panel drawn", box is not None, box):
        return
    sf = h.sf
    s.check("panel height (58 + 6) x sf", abs(box_size(box)[1] - 64 * sf) <= 1, box_size(box))
    x0 = box[0] + (HL_PAD + 21) * sf
    top = box[1] + HL_PAD * sf

    def band(row, dy0, dy1):
        return (x0, top + (row * 20 + dy0) * sf, box[2], top + (row * 20 + dy1) * sf - 1)
    third = [count_exact(f, band(2, 1, 10), HL_WHITE) for f in frames]
    s.check("row 3 (9 s left) blinks: present and absent across shots", max(third) > 0 and min(third) == 0, third)
    for row in (0, 1):
        names = [count_exact(f, band(row, 1, 10), HL_WHITE) for f in frames]
        times = [count_exact(f, band(row, 10, 19), HL_GRAY) for f in frames]
        s.check("row %d: white name in every shot" % (row + 1), min(names) > 0, names)
        s.check("row %d: gray time in every shot" % (row + 1), min(times) > 0, times)
    s.cmd("/effect @p clear")
    h.all_off()


def hl_mapinfo(h):
    s = h.s
    s.begin("HL-mapinfo", "Map Info: labels in the accent, values white")
    box = h.boxes.get("heightlimit")
    g = [x for x in h.groups if x[0] == "heightlimit"][0]
    h.only(g)
    img = h.shot("mapinfo")
    if not s.check("Map Info box known from HL-bg", box is not None, box):
