        jvm = common + [("-Dfabric.dli.config=" + staged_cfg) if a.startswith("-Dfabric.dli.config=") else a
                        for a in dump["jvmArgs"]]
        main, prog = dump["mainClass"], []
        classes_dir, resources_dir = m.stage(dump["classesDir"]), m.stage(dump["resourcesDir"])
    else:
        release = dump["releaseJar"]
        if not os.path.exists(release):
            die("release jar missing: " + release)
        problems = check_release_jar(release)
        if problems:
            die("the release jar is not clean: " + "; ".join(problems))
        if not os.path.exists(CLIENT_JAR) or sha1(CLIENT_JAR) != CLIENT_SHA1:
            die("vanilla 1.8.9 client jar missing or wrong at %s (sha1 %s expected)" % (CLIENT_JAR, CLIENT_SHA1))
        loader = [p for p in dump["classpath"] if os.path.basename(p).startswith("fabric-loader-")]
        # Production classpath, as the Ornithe installer / Prism builds it: Minecraft's libraries (with
        # the gen2 upgrades), Loader + ASM + Mixin, intermediary mappings, the vanilla (obfuscated) jar.
        # MixinExtras is a development-only library here; the Loader jar nests its own copy.
        loader_libs = [p for p in dump["loaderLibraries"] if "mixinextras" not in os.path.basename(p)]
        classpath = [m.stage(p) for p in dump["mcLibraries"] + loader_libs + loader
                     + [dump["intermediaryJar"], CLIENT_JAR]]
        mods = os.path.join(runtime, "mods")
        os.makedirs(mods, mode=0o755)
        copy_file(release, os.path.join(mods, os.path.basename(release)))
        for pin in pins_for("prod"):
