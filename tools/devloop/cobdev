def ov_chat_rows(s, img, ref, box, sf, scale, chat_scale=1.0):
    """(band rows, band top, band bottom) of chat fill in the right margin column (no text reaches it)."""
    x = chat_margin_column(box, scale, sf, chat_scale)
    band = band_rows(img, ref, x, CHAT_FILL, tol=0.05)
    if band is None:
        return 0, None, None
    row = 9 * chat_scale * scale * sf
    return int(round((band[1] - band[0]) / row)), band[0], band[1]


