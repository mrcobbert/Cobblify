POTION_ICON = 18.0  # BedwarsHudRenderer.POTION_ICON_SIZE
# Keystrokes caps in local units (KeystrokesLayout: CAP 18, GAP 1, 56 x 67, mouse row above the space bar): x, y, w, h.
KS_WIDTH = 56.0
KS_CAPS = {"W": (19, 0, 18, 18), "A": (0, 19, 18, 18), "S": (19, 19, 18, 18), "D": (38, 19, 18, 18),
           "Space": (0, 57, 56, 10), "LMB": (0, 38, 27.5, 18), "RMB": (28.5, 38, 27.5, 18)}


def px_box(x, y, w, h, sc, inset=0.0):
    """A GUI rectangle in screenshot pixels, shrunk by `inset` GUI px on every side."""
    return (int(round((x + inset) * sc)), int(round((y + inset) * sc)),
            int(round((x + w - inset) * sc)), int(round((y + h - inset) * sc)))


def cap_px(ks_box, cap, sc):
    """The middle 60% of a Keystrokes cap, in screenshot pixels; the caps are laid out at the box's own scale."""
    e = ks_box["w"] / KS_WIDTH
    x, y, w, h = KS_CAPS[cap]
    gx, gy = ks_box["x"] + (x + 0.2 * w) * e, ks_box["y"] + (y + 0.2 * h) * e
    return px_box(gx, gy, 0.6 * w * e, 0.6 * h * e, sc)


def edithud_e11(run):
    """E11: opening Edit HUD changes no item's content or size: inside the potion icon column, Armor, Inventory and
    Keystrokes (1 px border excluded), 99% of pixels differ by less than 24 levels between play and the editor (the
    editor's 15% dim behind translucent panels). Live data chosen to differ from the samples; timers and Map Info
    show their samples in singleplayer (reviewed shot)."""
    s = run.s
    ids = ("potion", "armor", "inventory", "keystrokes")
    for name in IN_GAME_ONLY:
        run.set(name, False)
    run.show_only(set(ids))
    for c in LIVE_DATA:
        s.cmd(c)
    try:
        hb = run.probe()
        sc = hb["scale"]
        s.call("/close")
        s.call("/hover", {"off": 1})
        time.sleep(1.0)
        _, play = s.shot("edithud-e11-play", wait=500)
        s.call("/open", {"class": SCREENS["hud"]})
        _, editor = s.shot("edithud-e11-editor", wait=600)
        hb2 = run.probe()
        for item in ids:
            b0, b1 = run.box(item, hb), run.box(item, hb2)
            s.check("E11 %s has the same box in play and in the editor" % item,
                    all(abs(p - q) <= 1e-3 for p, q in zip(vis(b0), vis(b1))), "%s vs %s" % (vis(b0), vis(b1)))
            w = POTION_ICON * run.state(item, hb)["scale"] if item == "potion" else b1["w"]
            area = px_box(b1["x"], b1["y"], w, b1["h"], sc, inset=1.0)
            frac, where = diff(play, editor, step=1, thresh=23, box=area)
            s.check("E11 %s: 99%% of pixels within 24 levels, play vs editor" % item, frac <= 0.01,
                    "%.4f differ, around %s" % (frac, where))
    finally:
        for c in LIVE_DATA_CLEAR:
            s.try_call("/command", post={"command": c})


def edithud_e11k(run):
    """E11k: in the editor, a held movement key lights its Keystrokes cap (keyboard state, held raw so the editor
    sees a real press and release); released, every movement cap is idle; the mouse caps stay unlit while the left
    button is down in the editor (D12); the player does not move."""
    s = run.s
    run.set("keystrokesInGameOnly", False)
    run.show_only({"keystrokes", "inventory"})
    hb = run.probe()
    sc = hb["scale"]
    ks = run.box("keystrokes", hb)
    pos0 = s.probe("player")["client"]["pos"]
    _, idle = s.shot("edithud-e11k-idle")

    def lit(img, cap):
        return diff(idle, img, step=1, thresh=23, box=cap_px(ks, cap, sc))[0] > 0.5

    try:
        s.call("/keyhold", {"name": "key.forward", "state": "on", "raw": 1})
        _, w = s.shot("edithud-e11k-w")
        s.check("E11k holding W lights the W cap", lit(w, "W"))
