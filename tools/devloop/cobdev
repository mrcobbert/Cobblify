def smoke_sprint(s, cfg):
    s.begin("A5-sprint", "Toggle Sprint: its key toggles, the sprint key is held while on")
    if not s.has("com.bedwarsqol.feature.ToggleSprint") or not cfg:
        return s.unavailable("Toggle Sprint is not in this build")
    en, on = cfg + ".toggleSprintEnabled", cfg + ".toggleSprintOn"
    s.field(en, True)
    s.field(on, False)
    bindings = (s.call("/keyhold") or {}).get("bindings", [])
    key = [k for k in bindings if k["name"] == TOGGLE_SPRINT_KEY]
    if not s.check("Toggle Sprint is listed in Controls (category Cobblify)", bool(key), [k["name"] for k in bindings]):
        return
    s.check("Toggle Sprint key is G by default", key[0]["code"] == 34, "code %s" % key[0]["code"])

    def press():
        s.call("/keyhold", {"name": TOGGLE_SPRINT_KEY, "state": "on"})
        time.sleep(0.3)
        s.call("/keyhold", {"name": TOGGLE_SPRINT_KEY, "state": "off"})
        time.sleep(0.3)
        return s.field(on).get("value") in (True, "true"), s.probe("player")["client"]["sprintKeyDown"]

    toggled, held = press()
    s.check("one press toggles on and holds the sprint key", toggled and held, "on=%s held=%s" % (toggled, held))
    toggled, held = press()
    s.check("a second press toggles off and releases it", not toggled and not held, "on=%s held=%s" % (toggled, held))
