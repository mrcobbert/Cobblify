def check_java():
    java = JAVA_HOME + "/bin/java"
    if not os.path.exists(java):
        die("JDK 25 not found at %s (install Temurin 25 arm64; the user's account must be able to read it)" % JAVA_HOME)
    p = subprocess.run([java, "-XshowSettings:properties", "-version"], capture_output=True, text=True)
    props = dict(re.findall(r"^\s+(\S+) = (.*)$", p.stderr, re.M))
    if not props.get("java.version", "").startswith("25") or props.get("os.arch") != "aarch64":
        die("%s is Java %s on %s; cobdev needs Java 25 on aarch64" % (java, props.get("java.version"), props.get("os.arch")))
    print("Java: %s %s (%s)" % (props.get("java.vendor"), props.get("java.version"), props.get("os.arch")))


def build_agent():
    with tempfile.TemporaryDirectory() as tmp:
        src = os.path.join(HERE, "agent", "src")
        sources = [os.path.join(r, n) for r, _, fs in os.walk(src) for n in fs if n.endswith(".java")]
        out = os.path.join(tmp, "classes")
        os.makedirs(out)
        # Pure JDK: the agent never links against Minecraft, LWJGL or Pylon (see Game.java).
        p = subprocess.run([JAVA_HOME + "/bin/javac", "--release", "8", "-nowarn", "-Xlint:-options",
                            "-d", out] + sources, capture_output=True, text=True)
        if p.returncode != 0:
            print(p.stdout + p.stderr)
            die("devagent compile failed")
        manifest = os.path.join(tmp, "MANIFEST.MF")
        write_text(manifest, "Premain-Class: cobdev.DevAgent\nCan-Redefine-Classes: true\n")
        jar = AGENT_JAR + ".tmp-cobdev"
        subprocess.run([JAVA_HOME + "/bin/jar", "cfm", jar, manifest, "-C", out, "."], check=True)
        os.chmod(jar, 0o644)
        os.replace(jar, AGENT_JAR)
    print("devagent.jar: built")


def fetch_pins():
    """Downloads each pinned mod once and keeps it only if size and sha512 match the pin."""
    os.makedirs(MODS, mode=0o755, exist_ok=True)
    for pin in PINS:
        dst = os.path.join(MODS, pin["file"])
        if os.path.exists(dst) and sha512(dst) == pin["sha512"]:
            continue
        print("downloading %s ..." % pin["file"])
        tmp = dst + ".tmp-cobdev"
        req = urllib.request.Request(pin["url"], headers={"User-Agent": "cobdev-dev-tool"})
        with urllib.request.urlopen(req, timeout=600) as r, open(tmp, "wb") as f:
            shutil.copyfileobj(r, f)
        got = sha512(tmp)
        if got != pin["sha512"] or os.path.getsize(tmp) != pin["size"]:
            os.remove(tmp)
            die("%s does not match its pin (sha512 %s..., %d bytes)" % (pin["file"], got[:16], os.path.getsize(tmp)))
        os.chmod(tmp, 0o644)
        os.replace(tmp, dst)
    print("pinned mods: %d verified in %s" % (len(PINS), MODS))


