def edithud_corner_grow(run, item, other, corner, gap):
    """Shared by E7/E7b: `other` is put `gap` GUI px beside `item` at its height (Alt), then `item` is grown by
    `corner` ('br' or 'tl') well past it. Returns (before, after) probes."""
    s = run.s
    b = run.box(item)
    x, y, w, h = vis(b)
    o = run.box(other)
    ox, oy, ow, oh = vis(o)
    target_x = x + w + gap if corner == "br" else x - gap - ow
    run.device_drag(other, target_x - ox, y - oy, mods="alt")
    cx, cy = gui_centre(b)
    s.call("/click", {"x": cx, "y": cy})  # select it, so its corner handles take the press
    before = run.probe()
    b = run.box(item, before)
    x, y, w, h = vis(b)
    gx, gy = (int(x + w - 1), int(y + h - 1)) if corner == "br" else (int(x + 1), int(y + 1))
    far = 200 if corner == "br" else -200
    s.call("/down", {"x": gx, "y": gy})
    s.call("/drag", {"x": gx + far // 4, "y": gy})
    s.call("/drag", {"x": gx + far, "y": gy})
    after = run.probe()
    s.call("/up", {"x": gx + far, "y": gy})
    return before, after


