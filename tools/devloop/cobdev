def hl_text(h):
    s = h.s
    s.begin("HL-text", "FPS, CPS, Ping: 18 px boxes hugging the text, units in the accent, CPS divider, [bare] Off")
    sf = h.sf
    by = {g[0]: g for g in h.groups}
    h.all_off()
    none = h.shot("text-none")
    for name in ("fps", "cps", "ping"):
        h.only(by[name])
        on = h.shot(name + "-on")
        h.group_bg(by[name], False)
        off = h.shot(name + "-off")
        h.group_bg(by[name], True)
        box, bare = bbox_diff(none, on), bbox_diff(none, off)
        if not s.check(name + ": drawn", box is not None and bare is not None, (box, bare)):
            continue
        w, hgt = box_size(box)
        s.check(name + ": box 18 px tall", hgt == 18 * sf, hgt)
        if name == "fps":
            s.check("fps: width for 1-4 digits", w in [hl_text_box_width(["9" * d, " FPS"]) * sf for d in (1, 2, 3, 4)], w)
        s.check(name + ": unit in the accent", count_exact(on, box, HL_ACCENT_RGB) > 0)
        s.check(name + ": number white", count_exact(on, box, HL_WHITE) > 0)
        if name == "cps":
            gray = xs_of(on, box, HL_GRAY)
            col = (gray[0], box[1], gray[0], box[3]) if gray else None
            s.check("cps: divider 1 x 8 px column of gray", col is not None and count_exact(on, col, HL_GRAY) == 8 * sf,
                    col and count_exact(on, col, HL_GRAY))
            sh = (gray[0] + sf, box[1], gray[0] + sf, box[3]) if gray else None
            s.check("cps: divider shadow one px right and down", sh is not None and count_exact(on, sh, HL_DIVIDER_SHADOW) > 0)
        if name == "ping":
            ys = ys_of(on, box, HL_WHITE)
            s.check("ping: '--' (white on one font row)", ys is not None and ys[1] - ys[0] + 1 == sf, ys)
        s.check(name + " Off: bare text at most 9 px tall", box_size(bare)[1] <= 9 * sf, box_size(bare))
    # The Auto layout follows a Background switch: CPS moves up by FPS's height change (18 -> 9 + 2 x 3).
    h.all_off()
    h.f(by["fps"][1], True)
    h.f(by["cps"][1], True)
    a = h.shot("fps-cps-on")
    h.group_bg(by["fps"], False)
    b = h.shot("fps-cps-fpsoff")
    h.group_bg(by["fps"], True)
    ra = changed_runs(none, a, bbox_diff(none, a) or (0, 0, 0, 0), "y")
    rb = changed_runs(none, b, bbox_diff(none, b) or (0, 0, 0, 0), "y")
    moved = (ra[1][1] - rb[1][1]) if len(ra) == 2 and len(rb) == 2 else None
    s.check("CPS's Auto box moves with FPS's Background (3 GUI px)", moved is not None and abs(moved - 3 * sf) <= 1,
            (ra, rb))
    h.all_off()


def hl_edit(h):
    s = h.s
    s.begin("HL-edit", "FPS in Edit HUD: drag moves it, a corner resizes it, Delete hides it")
    p = HL_LAYOUT["fps"]
    h.all_off()
    h.f("fpsEnabled", True)
    h.f(p + "Anchor", 0)
    h.f(p + "X", 40)
    h.f(p + "Y", 60)
    x0 = h.f(p + "X").get("value")
    sc0 = h.f(p + "Scale").get("value")
    s.call("/open", {"class": SCREENS["hud"]})
    time.sleep(0.6)
    w = hl_text_box_width(["150", " FPS"])  # the editor's example value
    cx, cy = 40 + w // 2, 60 + 9
    s.call("/down", {"x": cx, "y": cy})
    s.call("/drag", {"x": cx + 50, "y": cy})
    s.call("/up", {"x": cx + 50, "y": cy})
    time.sleep(0.3)
    x1 = h.f(p + "X").get("value")
    s.check("fpsHudX moved by ~50 (snap allowed)", x1 is not None and abs((x1 - x0) - 50) <= 8, (x0, x1))
    rx, ry = (x1 or 90) + w - 1, 60 + 17
    s.call("/down", {"x": rx, "y": ry})
    s.call("/drag", {"x": rx + 20, "y": ry + 20})
    s.call("/up", {"x": rx + 20, "y": ry + 20})
    time.sleep(0.3)
    sc1 = h.f(p + "Scale").get("value")
    s.check("fpsHudScale grew", sc1 is not None and sc0 is not None and sc1 > sc0, (sc0, sc1))
    s.call("/click", {"x": cx + 50, "y": cy})
    s.call("/key", {"code": KEYS["delete"]})
    time.sleep(0.3)
    s.check("Delete hid FPS", h.f("fpsEnabled").get("value") is False)
    s.call("/close")
    h.f(p + "Anchor", -1)
    h.f(p + "Scale", 1.0)
    h.all_off()


def hl_scale(h):
    s = h.s
    s.begin("HL-scale", "small and fractional module scales: text stays in its box, Auto boxes never overlap")
    by = {g[0]: g for g in h.groups}
    names = ["potion", "fps", "cps", "ping", "keystrokes"]
    for gui, scale in ((1, 0.3), (2, 0.75)):
        s.call("/scale", {"n": gui})
        sf = (s.status() or {}).get("scaleFactor") or gui
        for i in ("potion", "fps", "cps", "ping", "keystrokes", "armor"):
            h.f(HL_LAYOUT[i] + "Scale", scale)
        s.cmd("/effect @p clear")
        for c in ("/effect @p 1 45 1 true", "/effect @p 8 45 4 true", "/effect @p 14 45 0 true"):
            s.cmd(c)
        s.call("/close")
        h.all_off()
        none = h.shot("scale-%d-none" % gui)
        on_boxes = {}
        for bg in (True, False):
            for name in names:
                h.group_bg(by[name], bg)
            for name in names:
                h.only(by[name])
                img = h.shot("scale-%d-%s-%s" % (gui, name, "on" if bg else "off"))
                box = bbox_diff(none, img)
                label = "GUI %d, %.2f, %s, Background %s" % (gui, scale, name, "On" if bg else "Off")
                if box is None:
                    s.check(label + ": drawn", False)
                elif bg:
                    on_boxes[name] = box
                    if name != "keystrokes":
                        edge = ring(box, 0)
                        bad = sum(1 for p in edge if not see_through_ok(px(img, *p), px(none, *p)))
                        s.check(label + ": text inside its panel", bad <= len(edge) // 20,
                                "%d/%d edge px are not panel" % (bad, len(edge)))
                else:
                    # bare: the margin replaces the panel's padding, so the text stays near where the panel was
                    s.check(label + ": text where its panel was", inside(box, grow(on_boxes.get(name, box), (HL_PAD + 2) * sf)),
                            (box, on_boxes.get(name)))
            h.all_off()
            for name in ("armor", "fps", "cps", "ping", "potion"):
                h.f(by[name][1], True)
            img = h.shot("scale-%d-column-%s" % (gui, "on" if bg else "off"))
            col = bbox_diff(none, img)
            runs = changed_runs(none, img, col, "y") if col else []
            # bare potion rows have a gap between them (3 effects: 3 runs), a panel does not
            want = 5 if bg else 7
            s.check("GUI %d, %.2f, Background %s: armor, fps, cps, ping, potion stacked without overlap (%d runs)"
                    % (gui, scale, "On" if bg else "Off", want), len(runs) == want and disjoint(runs), runs)
            h.all_off()
        for name in names:
            h.group_bg(by[name], True)
    for i in ("potion", "fps", "cps", "ping", "keystrokes", "armor"):
        h.f(HL_LAYOUT[i] + "Scale", 1.0)
    s.call("/scale", {"n": 2})
    s.cmd("/effect @p clear")


def hl_font(h):
    s = h.s
    s.begin("HL-font", "Modern font: potion and FPS/CPS/Ping text keeps a shadow with the Background off")
    by = {g[0]: g for g in h.groups}
    h.f("guiFont", "modern")
    try:
        s.cmd("/effect @p clear")
        h.all_off()
        none = h.shot("font-none")
        for c in ("/effect @p 1 45 1 true", "/effect @p 8 45 4 true", "/effect @p 14 45 0 true"):
            s.cmd(c)
        s.call("/close")
        for name in ("potion", "fps", "cps", "ping"):
            h.group_bg(by[name], False)
            h.only(by[name])
            img = h.shot("font-" + name)
            box = bbox_diff(none, img)
            n = count_near(img, box, HL_SHADOW, 8) if box else 0
            s.check(name + ": Inter shadow pixels", n >= 10, n)
            h.group_bg(by[name], True)
    finally:
        h.f("guiFont", "minecraft")
        s.cmd("/effect @p clear")
        h.all_off()


def hl_icons(h, cold):
    s = h.s
    tag = "cold" if cold else "warm"
    s.begin("HL-icons-" + tag, "modern potion icons, %s cache: %s" % (
        tag, "one real fetch from Mojang through the production path" if cold else "no request"))
    if cold:
        h.icon_dir = "/private/tmp/cobblify-smoke-icons-" + time.strftime("%Y%m%d-%H%M%S")
    elif not h.icon_dir:
        return s.unavailable("the cold check did not run, so there is no cache directory to reuse")
    h.restart_game()
    s.field(ICONS + ".cacheDirOverride", h.icon_dir)  # before the loader exists (fresh JVM, title screen)
    h.enter_world()
    h.setup()
    g = HL_GROUPS[0]
    s.cmd("/effect @p 1 45 1 true")
    s.call("/close")
    h.only(g)
    state = None
    for _ in range(40):
        r, _ = s.try_call("/field", post={"path": ICONS + ".LOADER.state"})
        state = r and r.get("value")
        if state in ("READY", "FAILED"):
            break
        time.sleep(0.5)
    src = s.field(ICONS + ".LOADER.source").get("value")
    req = s.call("/invoke", post={"path": ICONS + ".LOADER.requests", "args": ""}).get("value")
    pub = s.call("/invoke", post={"path": ICONS + ".LOADER.published", "args": ""}).get("value")
    s.check("loader READY", state == "READY", state)
    s.check("source " + ("NETWORK" if cold else "CACHE"), src == ("NETWORK" if cold else "CACHE"), src)
    s.check("requests == %d" % (1 if cold else 0), req == (1 if cold else 0), req)
    s.check("23 icons published", pub == 23, pub)
    if cold:
        modern = h.shot("icons-modern")
        s.field(ICONS + ".enabled", False)
        old = h.shot("icons-1.8.9")
        s.field(ICONS + ".enabled", True)
        box = bbox_diff(old, modern)
        panel = h.boxes.get("potion")
        slot = (panel[0] + HL_PAD * h.sf, panel[1] + HL_PAD * h.sf, panel[0] + (HL_PAD + 18) * h.sf - 1,
                panel[1] + (HL_PAD + 18) * h.sf - 1) if panel else None
        s.check("the modern icon differs from the 1.8.9 one, only in the 18 x 18 icon slot",
                box is not None and inside(box, slot), (box, slot))
    s.cmd("/effect @p clear")
    h.all_off()


def smoke_hud_look(s, cfg, restart_game):
    s.begin("HL", "HUD look: setup (singleplayer, scale 2, Minecraft font, pale blue, HUD Size Medium, all Auto)")
    if not cfg or not s.has("com.bedwarsqol.hud.HudBackground"):
        return s.unavailable("the per-item Background (HudBackground) is not in this build")
    h = HudLook(s, cfg, restart_game)
    h.snapshot()
    h.icon_dir = None
    try:
        h.setup()
        s.check("setup done", True, {"scaleFactor": h.sf, "modules": [g[0] for g in h.groups]})
        subs = [hl_bg, hl_persist, hl_potion, hl_mapinfo, hl_keys, hl_text, hl_edit, hl_scale, hl_font,
                lambda x: hl_icons(x, True), lambda x: hl_icons(x, False)]  # icons last: they restart the game
        for sub in subs:
            try:
                sub(h)
            except ForeignSave:
                raise
            except (ApiError, KeyError, TypeError, ValueError, IndexError) as e:
                s.error(e)
    finally:
        h.restore()


def cmd_smoke(args):
    wt = worktree(args)
    take_lock(wt, args.steal)
    mode = "prod" if args.prod else "dev"
    st = api_quiet("/status")
    if not st:
        die(NOT_RUNNING)
    fresh = st.get("mode") != mode or not args.no_stage
    if fresh:
        print("staging %s mode and restarting the game..." % mode)
        args.prod = mode == "prod"
        restart(wt, args, stage=True)
    s = Smoke(mode, source_of(os.path.realpath(os.path.join(SHARED, "current"))))
    steps = [lambda: smoke_boot(s, mode, fresh)]
    cfg_box = {}
    if not args.boot_only:
        steps += [lambda: smoke_screen(s, "A4-settings", "settings screen", "settings"),
                  lambda: smoke_screen(s, "A4-hudeditor", "HUD editor", "hud"),
                  lambda: smoke_world(s),
                  lambda: cfg_box.setdefault("cfg", find_config(s)),
                  lambda: smoke_hurt(s, cfg_box.get("cfg")),
                  lambda: smoke_zoom(s, cfg_box.get("cfg")),
                  lambda: smoke_sprint(s, cfg_box.get("cfg")),
                  lambda: smoke_hud(s, cfg_box.get("cfg")),
                  lambda: smoke_hud_look(s, cfg_box.get("cfg"), lambda: restart(wt, args, stage=False)),
                  lambda: smoke_overlays(s, cfg_box.get("cfg")),
                  lambda: smoke_clutch(s, cfg_box.get("cfg"))]
    for step in steps:
        try:
            step()
        except ForeignSave as e:
            s.error(e)  # every later step edits the world: stop the run
            break
        except (ApiError, KeyError, TypeError, ValueError) as e:
            if s.step is None:
                raise
            s.error(e)
    s.report["finished"] = time.strftime("%Y-%m-%d %H:%M:%S")
    s.report["finalStatus"] = api_quiet("/status")
    os.makedirs(REPORTS, exist_ok=True)
    out = os.path.join(REPORTS, "smoke-%s-%s.json" % (time.strftime("%Y%m%d-%H%M%S"), mode))
    with open(out, "w") as f:
        json.dump(s.report, f, indent=2)
    print("\n%-14s %s" % ("step", "status"))
    for step in s.report["steps"]:
        print("%-14s %s" % (step["id"], step["status"]))
    print("report: " + out)
    if mode == "prod" and not args.keep:
        print("back to dev mode...")
        args.prod = False
        restart(wt, args, stage=True)
    if any(step["status"] == "fail" for step in s.report["steps"]):
        sys.exit(1)


