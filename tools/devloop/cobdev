API = "http://127.0.0.1:47821"
JDK_URL = "https://cdn.azul.com/zulu/bin/zulu8.96.0.205-ca-jdk8.0.504-macosx_x64.tar.gz"
JDK_SHA256 = "e35bc8a4401193aa670146762bbad132bf0651fee5e3f16acbb3a5db0e0b0cff"
BUILD_JDK = "/Library/Java/JavaVirtualMachines/zulu-8.jdk/Contents/Home"
HOME = os.path.expanduser("~")
GRADLE_CACHES = os.path.join(HOME, ".gradle", "caches")
HERE = os.path.dirname(os.path.realpath(__file__))
