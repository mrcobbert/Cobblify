def cmd_selftest(args):
    """Checks that need no game: the bridge's refusal rules, image helpers, launch.cfg rewriting, jar check."""
    with tempfile.TemporaryDirectory() as tmp:
        src = [os.path.join(HERE, "bridge", "src", "cobdev", "bridge", n) for n in ("Policy.java", "Refused.java")]
        src.append(os.path.join(HERE, "bridge", "test", "cobdev", "bridge", "PolicyTest.java"))
        p = subprocess.run([JAVA_HOME + "/bin/javac", "--release", "8", "-Xlint:-options", "-d", tmp] + src,
                           capture_output=True, text=True)
        if p.returncode != 0:
            die("PolicyTest compile failed:\n" + p.stdout + p.stderr)
        p = subprocess.run([JAVA_HOME + "/bin/java", "-cp", tmp, "cobdev.bridge.PolicyTest"], capture_output=True, text=True)
        print((p.stdout + p.stderr).strip())
        if p.returncode != 0:
            sys.exit(1)
    p = subprocess.run([sys.executable, "-I", os.path.join(HERE, "test_cobdev.py")], capture_output=True, text=True)
    print((p.stdout + p.stderr).strip())
    if p.returncode != 0:
        sys.exit(1)
    print("selftest passed")


