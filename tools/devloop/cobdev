# Minecraft's default window, common laptop and desktop displays (1920x1080 and 2560x1440 are three quarters of Steam),
# the Steam Deck, a 14" MacBook in points, ultrawides and 4K; override with --displays.
DISPLAYS = ("854x480,1280x720,1280x800,1366x768,1440x900,1512x982,1536x864,1600x900,1920x1080,1920x1200,"
            "2560x1080,2560x1440,2560x1600,3440x1440,3840x2160")
# The settings fields a sweep changes; it puts them all back when it ends.
SWEPT_FIELDS = ("guiSize", "guiFont", "defaultTextSize", "potionHudScale", "armorHudScale", "inventoryHudScale",
                "diamondTimerHudScale", "emeraldTimerHudScale", "keystrokesHudScale", "sessionStatsHudScale",
                "heightLimitHudScale")
SIZE_NAMES = ("small", "medium", "large")
