SMOKE_SAVE = "cobdev"  # the bridge's /world creates and opens this save


class ForeignSave(Exception):
    """The open singleplayer world is not the smoke's own save: the smoke must not touch it."""


def require_smoke_save(result):
    save = (result or {}).get("save")
    if save != SMOKE_SAVE:
        raise ForeignSave("the open world is save %r, not %r: the smoke clears entities and terrain, so it "
                          "stops here. Leave that world (or let a fresh boot open %r) and rerun"
                          % (save, SMOKE_SAVE, SMOKE_SAVE))


