        s.call("/keyhold", {"name": "key.jump", "state": "on", "raw": 1})
        _, wj = s.shot("edithud-e11k-w-space")
        s.check("E11k W and Space held light both caps", lit(wj, "W") and lit(wj, "Space"))
    finally:
        s.try_call("/keyhold", {"name": "key.forward", "state": "off", "raw": 1})
        s.try_call("/keyhold", {"name": "key.jump", "state": "off", "raw": 1})
    _, off = s.shot("edithud-e11k-released")
    s.check("E11k after release every movement cap is idle", not any(lit(off, c) for c in ("W", "A", "S", "D", "Space")))
    cx, cy = gui_centre(run.box("inventory", hb))
    s.call("/down", {"x": cx, "y": cy})
    try:
        _, down = s.shot("edithud-e11k-lmb")
        s.check("E11k the mouse caps stay unlit with the left button down", not lit(down, "LMB") and not lit(down, "RMB"))
    finally:
        s.call("/up", {"x": cx, "y": cy})
    pos1 = s.probe("player")["client"]["pos"]
    s.check("E11k the player did not move", all(abs(p - q) < 1e-6 for p, q in zip(pos0, pos1)), "%s -> %s" % (pos0, pos1))


