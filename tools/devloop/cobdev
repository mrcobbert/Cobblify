def edithud_e5_e6(run):
    """E5: Keystrokes in the screen centre is a wall Map Info goes around: dragged 30 px into its left side, Map
    Info sits flush left of it; 30 px short of its right side, flush right of it. (Deep in the middle the nearest
    free spot is above or below, so the checks stay 30 px from each side.) E6: with Alt it overlaps Keystrokes;
    one plain pixel later it is clear again."""
    s = run.s
    run.show_only(None)
    hb = run.probe()
    sc, sw, sh = hb["scale"], hb["sw"], hb["sh"]
    ks = run.box("keystrokes", hb)
    kx, ky, kw, kh = vis(ks)
    run.device_drag("keystrokes", sw / 2.0 - (kx + kw / 2.0), sh / 2.0 - (ky + kh / 2.0), mods="alt")
    ks = run.box("keystrokes")
    kx, ky, kw, kh = vis(ks)
    mi = run.box("heightlimit")
    mx, my, mw, mh = vis(mi)
    run.device_drag("heightlimit", 0, (ky + kh / 2.0) - (my + mh / 2.0), mods="alt")  # the same height
    for raw, want, side in ((kx - mw + 30, kx - mw, "left"), (kx + kw - 30, kx + kw, "right")):
        mi = run.box("heightlimit")
