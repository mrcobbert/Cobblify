    missing += [pin_path(p["name"]) for p in PINS if not os.path.exists(pin_path(p["name"]))]
    if missing:
        die("not set up yet (missing %s); run: tools/devloop/cobdev setup" % ", ".join(missing))


def gradle(wt, *args, init=True, extra_props=None):
    cmd = [os.path.join(wt, "ornithe", "gradlew"), "-q"]
    if init:
        cmd += ["--init-script", os.path.join(HERE, "devloop.init.gradle"),
                "-PcobdevBridgeDir=" + os.path.join(HERE, "bridge"),
                "-PcobdevDevMods=" + ",".join(pin_path(p["name"]) for p in pins_for("dev"))]
    cmd += ["-P%s=%s" % kv for kv in (extra_props or {}).items()] + list(args)
    p = subprocess.run(cmd, cwd=os.path.join(wt, "ornithe"), stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                       text=True)
    noise = ("duplicate input class", "WARNING:", "is obsolete", "-Xlint:-options", "warnings")
    out = "\n".join(l for l in p.stdout.splitlines() if not any(n in l for n in noise))
    if p.returncode != 0:
        print(out)
        die("gradle failed")


