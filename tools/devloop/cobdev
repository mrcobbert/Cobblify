    sf = h.sf
    top = box[1] + HL_PAD * sf
    for row, label in enumerate(("Map", "Height Limit", "Distance")):
        band = (box[0], top + row * 11 * sf, box[2], top + (row * 11 + 9) * sf - 1)
        accent, white = xs_of(img, band, HL_ACCENT_RGB), xs_of(img, band, HL_WHITE)
        s.check("%s: label in the accent" % label, accent is not None, accent)
        s.check("%s: value white, right of the label" % label,
                white is not None and accent is not None and white[0] > accent[1], (accent, white))
