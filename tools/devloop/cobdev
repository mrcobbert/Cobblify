    write_text(os.path.join(launch, "resources.dir"), resources_dir + "\n")
    write_text(os.path.join(launch, "source.json"), json.dumps({
        "worktree": wt, "branch": branch, "commit": git(wt, "rev-parse", "--short", "HEAD"), "mode": mode,
        "buildClasses": dump["classesDir"], "buildResources": dump["resourcesDir"],
        "releaseJar": dump["releaseJar"] if mode == "prod" else None,
        "staged": time.strftime("%Y-%m-%d %H:%M:%S")}, indent=2) + "\n")

    tmp_link = os.path.join(SHARED, ".current-tmp")
    if os.path.lexists(tmp_link):
