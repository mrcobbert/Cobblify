def hl_scale_checks(gui, scale, sf, names, backdrops, frames):
    """HL-scale's checks for one GUI scale, from its frames {(background, name or "column"): image}, as
    (check, ok, detail). Boxes are clusters of the pixels that differ from both backdrops (before and after), so
    the horizon redrawing far chunks in one backdrop does not count."""
    before, after = backdrops
    out, on_boxes = [], {}
    for bg in (True, False):
        for name in names:
            img = frames[(bg, name)]
            near = on_boxes.get(name)
            box = (union_box(hud_boxes(before, img, grow(near, (HL_PAD + 6) * sf), also=after))
                   if not bg and near else hud_bbox(before, img, also=after))
            label = "GUI %d, %.2f, %s, Background %s" % (gui, scale, name, "On" if bg else "Off")
            if box is None:
                out.append((label + ": drawn", False, None))
            elif bg:
                on_boxes[name] = box
                if name != "keystrokes":
                    none = hl_backdrop(img, backdrops, box, sf)
                    edge = ring(box, 0)
                    bad = sum(1 for p in edge if not see_through_ok(px(img, *p), px(none, *p)))
                    out.append((label + ": text inside its panel", bad <= len(edge) // 20,
                                "%d/%d edge px are not panel" % (bad, len(edge))))
            else:
                # bare: the margin replaces the panel's padding, so the text stays near where the panel was
                out.append((label + ": text where its panel was", inside(box, grow(on_boxes.get(name, box), (HL_PAD + 2) * sf)),
                            (box, on_boxes.get(name))))
        img = frames[(bg, "column")]
        col = union_box(hud_boxes(before, img, also=after))  # bare modules are separate clusters
        runs = changed_runs(hl_backdrop(img, backdrops, col, sf), img, col, "y") if col else []
        # bare potion rows have a gap between them (3 effects: 3 runs), a panel does not
        want = 5 if bg else 7
        out.append(("GUI %d, %.2f, Background %s: armor, fps, cps, ping, potion stacked without overlap (%d runs)"
                    % (gui, scale, "On" if bg else "Off", want), len(runs) == want and disjoint(runs), runs))
    return out


def hl_scale(h):
    s = h.s
    s.begin("HL-scale", "small and fractional module scales: text stays in its box, Auto boxes never overlap")
    by = {g[0]: g for g in h.groups}
    names = ["potion", "fps", "cps", "ping", "keystrokes"]
    for gui, scale in ((1, 0.3), (2, 0.75)):
        s.call("/scale", {"n": gui})
        sf = (s.status() or {}).get("scaleFactor") or gui
        for i in ("potion", "fps", "cps", "ping", "keystrokes", "armor"):
            h.f(HL_LAYOUT[i] + "Scale", scale)
        s.cmd("/effect @p clear")
        for c in ("/effect @p 1 45 1 true", "/effect @p 8 45 4 true", "/effect @p 14 45 0 true"):
            s.cmd(c)
        s.cmd("/tp @p 0.5 4 0.5 0 0")
        s.call("/close")
        h.all_off()
        time.sleep(0.6)  # the FOV settles after the effects
        before = h.shot("scale-%d-none" % gui)
        frames = {}
        for bg in (True, False):
            for name in names:
                h.group_bg(by[name], bg)
            for name in names:
                h.only(by[name])
                frames[(bg, name)] = h.shot("scale-%d-%s-%s" % (gui, name, "on" if bg else "off"))
            h.all_off()
            for name in ("armor", "fps", "cps", "ping", "potion"):
                h.f(by[name][1], True)
            frames[(bg, "column")] = h.shot("scale-%d-column-%s" % (gui, "on" if bg else "off"))
            h.all_off()
        for name in names:
            h.group_bg(by[name], True)
        after = h.shot("scale-%d-none-after" % gui)
        for check, ok, detail in hl_scale_checks(gui, scale, sf, names, (before, after), frames):
            s.check(check, ok, detail)
    for i in ("potion", "fps", "cps", "ping", "keystrokes", "armor"):
        h.f(HL_LAYOUT[i] + "Scale", 1.0)
    s.call("/scale", {"n": 2})
    s.cmd("/effect @p clear")


