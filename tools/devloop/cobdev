def find_config(s):
    for holder in CONFIG_HOLDERS:
        if s.has(holder, "config"):
            r, _ = s.try_call("/field", post={"path": holder + ".config"})
            if r and r.get("value") is not None:
                return holder + ".config"
    return None


def find_field(s, cfg, names):
    if not cfg:
        return None
    for n in names:
        r, _ = s.try_call("/field", post={"path": cfg + "." + n})
        if r is not None:
            return cfg + "." + n
    return None


def parse_mod_list(lines):
    """Fabric Loader's "Loading N mods:" block: top-level ("- id ver") and nested ("|-- id ver") entries."""
    for i, line in enumerate(lines):
        if re.search(r"Loading \d+ mods:", line):
            ids = []
            for entry in lines[i + 1:]:
                m = re.match(r"^\t[\s|]*(?:[|\\]--|-) (\S+) ", entry)
                if not m:
                    break
                ids.append(m.group(1))
            return line.strip(), ids
    return None, []


def close_enough(a, b, tol):
    return a is not None and b is not None and abs(a - b) <= tol


def smoke_boot(s, mode, fresh):
    s.begin("A3", "boot to title (%s mode): mods, ready line, no mixin errors" % mode)
    st = s.status()
    s.check("ready and responsive", st.get("ready") and st.get("responsive"), st.get("reason"))
    if fresh or not st.get("inWorld"):
        s.check("title screen reached", st.get("title") is True, st.get("screen"))
    else:  # --no-stage on a game an earlier run left in the world: the title check needs a fresh boot
        s.step["checks"].append({"check": "title screen reached", "ok": None,
                                 "detail": "not checked: the running game is already in a world (no restart)"})
        print("   n/a  title screen reached: game already in a world (rerun without --no-stage)")
    s.check("running mode is " + mode, st.get("mode") == mode, st.get("mode"))
    log = s.call("/log", {"lines": 4000})["lines"]
    text = "\n".join(log)
    header, listed = parse_mod_list(log)
    s.step["modList"] = listed
    s.check("Fabric lists its mods", bool(listed), header or "no 'Loading N mods' line")
    for mod in EXPECTED_MODS[mode]:
        s.check("mod loaded: " + mod, mod in listed)
    if READY_LINE in text:
        s.check("ready line: " + READY_LINE, True)
    elif STUB_LINE in text:
        s.step["checks"].append({"check": "ready line", "ok": None, "detail": "not available yet (stub logs '%s')" % STUB_LINE})
        print("   n/a  ready line: not available yet (Phase 1 stub)")
    else:
        s.check("ready line: " + READY_LINE, False, "neither the ready line nor the stub's init line is in the log")
    errors = [l for l in log if re.search(r"Mixin apply (for mod \S+ )?failed|InvalidInjectionException|MixinApplyError"
                                          r"|InjectionError|Critical injection failure|MixinTransformerError"
                                          r"|NoSuchFieldError|NoSuchMethodError|InvalidMixinException", l)]
    s.check("no mixin/injection/linkage errors", not errors, errors[:5] or None)
    warns = [l for l in log if "ClassNotFoundException" in l or "/ERROR]" in l]
    s.step["logWarnings"] = warns[:20]
    path, img = s.shot("title", wait=500)
    s.check("title frame is not blank", spread(img) > 8, "spread %.1f" % spread(img))


