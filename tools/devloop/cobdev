def hl_pressed_cap(img, box, sf):
    """(accent px, dark-letter px) inside the W cap of the Keystrokes box. Edit HUD paints its faint frame fill over
    the preview, which tints both colours a little, so they are matched with a tolerance, inside the cap only."""
    c = HL_CAPS[0]
    cap = (box[0] + int(round(c[0] * sf)), box[1] + int(round(c[1] * sf)),
           box[0] + int(round((c[0] + c[2]) * sf)) - 1, box[1] + int(round((c[1] + c[3]) * sf)) - 1)
    return count_near(img, cap, HL_ACCENT_RGB, 8), count_near(img, cap, HL_PRESSED_TEXT, 16)


def hl_keys(h):
    s = h.s
    s.begin("HL-keys", "Keystrokes: pressed cap = solid accent + contrast letter (W held raw in the editor)")
    g = [x for x in h.groups if x[0] == "keystrokes"][0]
    # The caps' box from the game (HL-bg): the editor preview draws them in the same spot, but its frames and the
    # other modules' ghosts change around them, so a frame diff in the editor would measure editor chrome.
    box = h.boxes.get("keystrokes")
    if not s.check("Keystrokes box known from HL-bg", box is not None, box):
        return
    sf = h.sf
    got = box_size(box)
    s.check("in game: 56 x 67 px x sf, no CPS line under the space bar",
            abs(got[0] - 56 * sf) <= 1 and abs(got[1] - 67 * sf) <= 1, got)
    h.only(g)
    s.try_call("/hover", {"off": 1})
    s.call("/open", {"class": SCREENS["hud"]})
    time.sleep(0.6)
    # The editor shows live keys (edit-hud live preview): hold W's keyboard state, never its binding (edit-hud X6).
    s.call("/keyhold", {"name": "key.forward", "state": "on", "raw": 1})
    try:
        on = h.shot("keys-editor")
    finally:
        s.try_call("/keyhold", {"name": "key.forward", "state": "off", "raw": 1})
    s.call("/close")
    accent, letter = hl_pressed_cap(on, box, sf)
    s.check("the W cap is solid accent (W held)", accent >= (16 * sf) ** 2, accent)
    s.check("its letter in the contrast colour", letter > 0, letter)
    h.all_off()


def hl_text(h):
    s = h.s
    s.begin("HL-text", "FPS, CPS, Ping: 18 px boxes hugging the text, units in the accent, CPS divider, [bare] Off")
    sf = h.sf
    by = {g[0]: g for g in h.groups}
    h.all_off()
    none = h.shot("text-none")
    for name in ("fps", "cps", "ping"):
        h.only(by[name])
        on = h.shot(name + "-on")
        h.group_bg(by[name], False)
        off = h.shot(name + "-off")
        h.group_bg(by[name], True)
        h.all_off()
        after = h.shot(name + "-none-after")
        box, bare = hud_bbox(none, on, also=after), hud_bbox(none, off, also=after)
        if not s.check(name + ": drawn", box is not None and bare is not None, (box, bare)):
            continue
        w, hgt = box_size(box)
        s.check(name + ": box 18 px tall", hgt == 18 * sf, hgt)
        if name == "fps":
            s.check("fps: width for 1-4 digits", w in [hl_text_box_width(["9" * d, " FPS"]) * sf for d in (1, 2, 3, 4)], w)
        s.check(name + ": unit in the accent", count_exact(on, box, HL_ACCENT_RGB) > 0)
        s.check(name + ": number white", count_exact(on, box, HL_WHITE) > 0)
        if name == "cps":
            gray = xs_of(on, box, HL_GRAY)
            col = (gray[0], box[1], gray[0], box[3]) if gray else None
            s.check("cps: divider 1 x 8 px column of gray", col is not None and count_exact(on, col, HL_GRAY) == 8 * sf,
                    col and count_exact(on, col, HL_GRAY))
            sh = (gray[0] + sf, box[1], gray[0] + sf, box[3]) if gray else None
            s.check("cps: divider shadow one px right and down", sh is not None and count_exact(on, sh, HL_DIVIDER_SHADOW) > 0)
        if name == "ping":
            ys = ys_of(on, box, HL_WHITE)
            s.check("ping: '--' (white on one font row)", ys is not None and ys[1] - ys[0] + 1 == sf, ys)
        s.check(name + " Off: bare text at most 9 px tall", box_size(bare)[1] <= 9 * sf, box_size(bare))
    # The Auto layout follows a Background switch: CPS moves up by FPS's height change (18 -> 9 + 2 x 3).
    h.all_off()
    h.f(by["fps"][1], True)
    h.f(by["cps"][1], True)
    a = h.shot("fps-cps-on")
    h.group_bg(by["fps"], False)
    b = h.shot("fps-cps-fpsoff")
    h.group_bg(by["fps"], True)
    h.all_off()
    after = h.shot("fps-cps-none-after")
    ra = changed_runs(none, a, union_box(hud_boxes(none, a, also=after)) or (0, 0, 0, 0), "y")
    rb = changed_runs(none, b, union_box(hud_boxes(none, b, also=after)) or (0, 0, 0, 0), "y")
    moved = (ra[1][1] - rb[1][1]) if len(ra) == 2 and len(rb) == 2 else None
    s.check("CPS's Auto box moves with FPS's Background (3 GUI px)", moved is not None and abs(moved - 3 * sf) <= 1,
            (ra, rb))
    h.all_off()


