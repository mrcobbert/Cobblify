TU_OTHER_MODULES = ("potionStatusEnabled", "armorTypeEnabled", "inventoryHudEnabled", "genTimersEnabled",
                    "keystrokesEnabled", "sessionStatsEnabled", "heightLimitEnabled")


def tu_sweep(s, hud_size, which, sizes, scales):
    """Edit HUD at every window size x GUI scale: a shot, and Team Upgrades' default spot clear of every
    switched-on module and the hotbar zone (probe hud-boxes)."""
    for size in sizes:
        if size:
            s.call("/size", {"w": size[0], "h": size[1]})
            time.sleep(1)
        for scale in scales:
            s.call("/scale", {"n": scale})
            s.call("/open", {"class": SCREENS["hud"]})
            time.sleep(0.6)
            tag = "tu-edithud-h%d-%s-%s-s%d" % (hud_size, which, "%dx%d" % size if size else "default", scale)
            _, img = s.shot(tag)
            s.check("frame " + tag, spread(img) > 8)
            gw, gh, boxes = tu_boxes(s)
            mine, others = tu_layout_overlaps(gw, gh, boxes)
            tu = boxes.get(TU_ID)
            room = tu_free_place(gw, gh, boxes, tu["w"], tu["h"]) if tu and mine else None
            detail = {"overlaps": mine, "box": tu, "gui": [gw, gh], "others (not Team Upgrades)": others,
                      "free place": room, "boxes": [boxes[k] for k in sorted(boxes)]}
            if which == "profile" or not mine or room:
                s.check("clear of modules and hotbar " + tag, not mine, detail)
            else:
                # every module on and no free place of the panel's size anywhere: the screen is full
                s.note("screen full with every module on " + tag, detail)
            s.call("/close")


def tu_move_keeps_size(s, cfg, mode):
    """Review code-2 I2: at 854x480, GUI scale 2, HUD Size 2 the default panel is stepped down to fit; select
    it in Edit HUD and press Right once: it moves one pixel and keeps its size, clear of the hotbar."""
    scale_path = cfg + ".teamUpgradesHudScale"
    configured = s.field(scale_path).get("value")
    if mode == "dev":
        s.call("/size", {"w": 854, "h": 480})
        time.sleep(1)
    s.call("/scale", {"n": 2})
    s.call("/open", {"class": SCREENS["hud"]})
    time.sleep(0.6)
    gw, gh, boxes = tu_boxes(s)
    before = boxes[TU_ID]
    s.call("/click", {"x": int(before["x"] + before["w"] / 2), "y": int(before["y"] + 4)})
    s.call("/key", {"code": KEYS["right"]})
    time.sleep(0.3)
    gw, gh, boxes = tu_boxes(s)
    after = boxes[TU_ID]
    s.shot("tu-moved")
    mine, _ = tu_layout_overlaps(gw, gh, {TU_ID: after})
    s.check("moving the stepped-down panel keeps its size, clear of the hotbar",
            abs(after["w"] - before["w"]) < 0.01 and abs(after["h"] - before["h"]) < 0.01
            and abs(after["x"] - before["x"] - 1) < 0.01 and not mine,
            {"before": before, "after": after, "gui": [gw, gh], "overlaps": mine})
    s.call("/close")
    s.field(cfg + ".teamUpgradesHudAnchor", -1)  # back to the default spot, at the configured size
    s.field(cfg + ".teamUpgradesHudX", 0)
    s.field(cfg + ".teamUpgradesHudY", 0)
    s.field(scale_path, configured)


def smoke_team_upgrades_look(s, cfg, mode):
    """Edit HUD (every module's example in its default spot) over window sizes x GUI scales, at the default
    and the largest HUD Size, plus the live panel (Compact and Full) at each HUD Size."""
    s.begin("TU-look", "Team Upgrades: Edit HUD layout sweep and HUD Size (%s)" % mode)
    if not cfg or not s.has(TU_WATCH):
        return s.unavailable(TU_WATCH + " is not in this build")
    en, lay, hs = cfg + ".teamUpgradesEnabled", cfg + ".teamUpgradesLayout", cfg + ".defaultTextSize"
    was = s.field(en).get("value"), s.field(lay).get("value"), s.field(hs).get("value")
    mods = [cfg + "." + f for f in TU_OTHER_MODULES]
    mods_was = [s.field(m).get("value") for m in mods]
    st = s.status()
    scale_was, display_was = st.get("guiScaleSetting", 0), st.get("display")
    sizes = TU_SIZES if mode == "dev" else [None]  # cobdev size is dev-only
    scales = [0, 1, 2, 3] if mode == "dev" else [1, 2, 3]  # Pylon breaks above 3 (issue #18)
    try:
        s.field(en, True)
        for hud_size in sorted({was[2], 2}):
            s.call("/invoke", post={"path": cfg + ".setHudSize", "args": str(hud_size)})
            s.field(lay, 0)
            for which in ("profile", "all"):  # the profile's modules, then every module switched on (the fullest layout)
                for m, v in zip(mods, mods_was):
                    s.field(m, True if which == "all" else v)
                tu_sweep(s, hud_size, which, sizes, scales)
            for m, v in zip(mods, mods_was):
                s.field(m, v)
            if hud_size == 2:
                tu_move_keeps_size(s, cfg, mode)
            if display_was and mode == "dev":
                s.call("/size", {"w": int(display_was.split("x")[0]), "h": int(display_was.split("x")[1])})
            s.call("/scale", {"n": scale_was})
