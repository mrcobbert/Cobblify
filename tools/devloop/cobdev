def check_release_jar(path, expect_version=None):
    """The release jar must be Cobblify alone: no cobdev bridge, no dev runtime mods nested in it."""
    problems = []
    with zipfile.ZipFile(path) as z:
        names = z.namelist()
        bad = [n for n in names if n.startswith("cobdev/") or "cobdev" in n.lower()]
        if bad:
            problems.append("cobdev entries: " + ", ".join(bad[:5]))
        nested = [n for n in names if n.startswith("META-INF/jars/") and n.endswith(".jar")]
        pinned = [n for n in nested if any(p["name"] in n.lower() for p in PINS)]
        if pinned:
            problems.append("nested dev runtime mods: " + ", ".join(pinned))
        try:
            meta = json.loads(z.read("fabric.mod.json"))
            if meta.get("id") != "bedwarsqol":
                problems.append("fabric.mod.json id is %s, not bedwarsqol" % meta.get("id"))
            if expect_version and meta.get("version") != expect_version:
                problems.append("fabric.mod.json version %s != %s" % (meta.get("version"), expect_version))
        except KeyError:
            problems.append("no fabric.mod.json")
    return problems


def cmd_jarcheck(args):
    wt = worktree(args)
    jar = args.jar or newest_release_jar(wt)
    problems = check_release_jar(jar)
    if problems:
        die("%s: %s" % (jar, "; ".join(problems)))
    print("%s: no cobdev bridge or dev runtime mods inside" % jar)


def newest_release_jar(wt):
    libs = os.path.join(wt, "ornithe", "build", "libs")
    jars = [os.path.join(libs, n) for n in os.listdir(libs) if n.endswith(".jar") and "-dev" not in n
            and "sources" not in n] if os.path.isdir(libs) else []
    if not jars:
        die("no release jar in %s; run: cd ornithe && ./gradlew build" % libs)
    return max(jars, key=os.path.getmtime)


def cmd_stage(args, wt=None):
    wt = wt or worktree(args)
    require_setup()
    take_lock(wt, args.steal)
    mode = "prod" if getattr(args, "prod", False) else "dev"
    started = time.time()
    if mode == "prod":
        # The release jar exactly as a release builds it: no init script, so no bridge source set and
        # no dev runtime mods exist in this configuration.
        gradle(wt, "remapJar", init=False)
    with tempfile.TemporaryDirectory() as tmp:
        dump_file = os.path.join(tmp, "dump.json")
        gradle(wt, "cobdevDump", extra_props={"cobdevOut": dump_file})
        with open(dump_file) as f:
            dump = json.load(f)
    branch = git(wt, "rev-parse", "--abbrev-ref", "HEAD")
    name = time.strftime("%Y%m%d-%H%M%S") + "-" + mode + "-" + re.sub(r"[^A-Za-z0-9._-]", "_", branch)
    runtime = os.path.join(SHARED, "runtimes", name)
    launch = os.path.join(runtime, "launch")
    os.makedirs(launch, mode=0o755)
    m = Mapper(wt, runtime)

    dli = [a for a in dump["jvmArgs"] if a.startswith("-Dfabric.dli.config=")]
    if not dli:
        die("runClient no longer passes -Dfabric.dli.config; update cobdev for this Loom")
    cfg_path = dli[0].split("=", 1)[1]
    with open(cfg_path) as f:
        cfg = f.read()

    agent = os.path.join(launch, "devagent.jar")
    copy_file(AGENT_JAR, agent)
    bridge = os.path.join(runtime, "bridge", "cobdev-bridge.jar")
    copy_file(dump["bridgeJar"], bridge)
    common = ["-Xms512M", "-Xmx2G"] + MAC_FLAGS + JAVA25_FLAGS + ["-javaagent:" + agent, "-Dcobdev.mode=" + mode]

    if mode == "dev":
