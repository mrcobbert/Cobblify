class Smoke:
    """Records every command, status and shot of a smoke run, step by step, into one JSON report."""

    def __init__(self, mode, source):
        self.report = {"mode": mode, "source": source, "started": time.strftime("%Y-%m-%d %H:%M:%S"), "steps": []}
        self.step = None

    def begin(self, sid, title):
        self.step = {"id": sid, "title": title, "status": "pass", "checks": [], "commands": [], "shots": []}
        self.report["steps"].append(self.step)
        print("== %s %s" % (sid, title))

    def call(self, path, params=None, post=None, timeout=60):
        rec = {"call": path, "params": params or post or {}}
        self.step["commands"].append(rec)
        try:
            r = api_try(path, params, post, timeout)
            rec["result"] = r
            return r
        except ApiError as e:
            rec["error"] = str(e)
            raise

    def try_call(self, path, params=None, post=None, timeout=60):
        try:
            return self.call(path, params, post, timeout), None
        except ApiError as e:
            return None, str(e)

    def cmd(self, command):
        self.call("/command", post={"command": command})
        time.sleep(0.3)

    def probe(self, name, *args):
        return self.call("/probe", post={"name": name, "args": ARG_SEP.join(str(a) for a in args)})

    def field(self, path, value=None):
        post = {"path": path}
        if value is not None:
            post["value"] = str(value).lower() if isinstance(value, bool) else str(value)
        return self.call("/field", post=post)

    def shot(self, tag, wait=300):
        path, _ = take_shot(wait=wait, tag="smoke-" + tag)
        self.step["shots"].append(path)
        return path, load_png(path)

    def status(self):
        st = api_quiet("/status") or {}
        self.step["commands"].append({"call": "/status", "result": st})
        return st

    def check(self, name, ok, detail=None):
        self.step["checks"].append({"check": name, "ok": bool(ok), "detail": detail})
        if not ok:
            self.step["status"] = "fail"
        print("   %s %s%s" % ("ok  " if ok else "FAIL", name, "  (%s)" % (detail,) if detail is not None else ""))
        return ok

    def unavailable(self, why):
        self.step["status"] = "not available yet"
        self.step["note"] = why
        print("   not available yet: " + why)

    def error(self, e):
        self.step["status"] = "fail"
        self.step["error"] = str(e)
        print("   FAIL error: %s" % e)

    def has(self, cls, member=None):
        r, _ = self.try_call("/has", {"class": cls, **({"member": member} if member else {})})
        return bool(r and r.get("present"))


