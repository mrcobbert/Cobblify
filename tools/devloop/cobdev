def parse_mods(text):
    """--mods alt,shift,ctrl: lower-cased, de-duplicated, in the order given; anything else is an error."""
    mods = []
    for raw in text.split(","):
        m = raw.strip().lower()
        if m not in MODIFIERS:
            raise argparse.ArgumentTypeError("--mods takes %s (comma-separated), not %r" % (", ".join(MODIFIERS), raw))
