    time.sleep(0.3)
    toggled = s.field(on).get("value") in (True, "true")
    held = s.probe("player")["client"]["sprintKeyDown"]
    s.check("turning Toggle Sprint off clears the toggle and releases the key", not toggled and not held,
            "on=%s held=%s" % (toggled, held))
    s.field(en, True)


def smoke_zoom(s, cfg):
    s.begin("A5", "Zoom: held lowers FOV, release restores it")
    keys, err = s.try_call("/keyhold")
    bindings = (keys or {}).get("bindings", [])
    s.step["cobblifyBindings"] = bindings
    zoom = [k for k in bindings if k["name"] == ZOOM_KEY]
    if not s.check("Zoom is listed in Controls (category Cobblify)", bool(zoom),
                   err or [k["name"] for k in bindings]):
        return
    s.check("Zoom key code (options key_Zoom)", zoom[0]["code"] != 0,
            "code %s%s" % (zoom[0]["code"], " (default C)" if zoom[0]["code"] == ZOOM_DEFAULT_CODE else ""))
    fr, _ = s.try_call("/field", post={"path": ZOOM_FACTOR_FIELD})
    factor = float(fr["value"]) if fr else None
    zf = find_field(s, cfg, ZOOM_FIELDS)
    if zf:
        s.field(zf, True)
    s.cmd("/tp @p ~ ~ ~ 0 0")
    time.sleep(0.5)
    base = s.probe("fov")["fov"]
    _, img0 = s.shot("zoom-base")
    s.call("/keyhold", {"name": ZOOM_KEY, "state": "on"})
    time.sleep(0.6)
    held = s.probe("fov")["fov"]
    _, img1 = s.shot("zoom-held")
    s.call("/keyhold", {"name": ZOOM_KEY, "state": "off"})
    time.sleep(0.6)
    after = s.probe("fov")["fov"]
    _, img2 = s.shot("zoom-released")
    s.step["fov"] = {"baseline": base, "held": held, "released": after, "factor": factor,
                     "ratio": held / base if base else None}
    if factor:
        s.check("held FOV <= baseline / ZOOM_FACTOR", held <= base / factor + 0.05,
                "%.2f -> %.2f, factor %s" % (base, held, factor))
    else:
        s.check("held FOV well below baseline (ZOOM_FACTOR unreadable)", held < base * 0.75, "%.2f -> %.2f" % (base, held))
    s.check("frame differs while held", diff(img0, img1)[0] > 0.05, "%.3f" % diff(img0, img1)[0])
    s.check("release restores FOV (not latched)", close_enough(after, base, 0.5), "%.2f vs %.2f" % (after, base))
    # Chat (bottom-left) fades and scrolls on its own; compare the rest of the frame. Chat is 320 GUI
    # px wide at the default chat width/scale, so on a narrow window it reaches past the middle.
    w, h, _ = img0
    sf = (s.status() or {}).get("scaleFactor") or 2
    chat_right = min(w, int((320 + 8) * sf))
    boxes = [(0, 0, w, int(h * 0.7))] + ([(chat_right, int(h * 0.7), w, h)] if chat_right < w - 8 else [])
    rest = max(diff(img0, img2, box=b)[0] for b in boxes)
    s.check("released frame matches baseline (outside chat)", rest < 0.02, "%.3f (whole frame %.3f)"
            % (rest, diff(img0, img2)[0]))
    if zf:
        s.field(zf, False)
        s.call("/keyhold", {"name": ZOOM_KEY, "state": "on"})
        time.sleep(0.6)
        off = s.probe("fov")["fov"]
        s.call("/keyhold", {"name": ZOOM_KEY, "state": "off"})
        s.check("Zoom disabled: holding the key changes nothing", close_enough(off, base, 0.5), "%.2f" % off)
        s.field(zf, True)
    else:
        s.check("Zoom setting found (%s)" % "/".join(ZOOM_FIELDS), False, "cannot check the disabled case")


