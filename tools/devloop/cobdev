def tu_reopen_world(s):
    """Save and Quit, then open the smoke save again: one world load, as when joining another game server."""
    s.call("/world", {"leave": "1"}, timeout=90)
    for _ in range(30):
        if (api_quiet("/status") or {}).get("title"):
            break
        time.sleep(1)
    time.sleep(5)  # the integrated server finishes saving on its own thread
    require_smoke_save(s.call("/world", timeout=120))
    for _ in range(90):
        st = api_quiet("/status") or {}
        if st.get("inWorld") and st.get("responsive"):
            break
        time.sleep(1)
    s.call("/close")
    time.sleep(2)


