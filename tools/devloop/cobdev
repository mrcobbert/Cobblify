class OvScene:
    """The fixed overlay scene, and a record of every Cobblify field it changed so `restore` puts it back."""

    def __init__(self, s, cfg):
        # backgrounds: each overlay item's Background as it was before the scene first touched it
        self.s, self.cfg, self.saved, self.scale, self.backgrounds = s, cfg, {}, None, {}

    def setup(self):
        st = self.s.status()
        self.scale = st.get("guiScaleSetting")
        self.s.call("/scale", {"n": 2})
        for c in ("/gamerule sendCommandFeedback false", "/gamerule doDaylightCycle false", "/time set 1000",
                  "/weather clear", "/effect @p clear", "/tp @p 0.5 4 0.5 0 -90"):
            self.s.cmd(c)
        for f in OV_MODULES:
            self.set(f, False)
        for item in OV_ITEMS:
            self.background(item, True)  # the On checks start from On, whatever the player chose
        # vanilla's default chat width, scale, heights and opacity (row heights, wrapping and the fill depend on them);
        # restore() puts the player's back with chat-heights restore
        self.s.probe("chat-defaults")
        self.s.call("/close")
        self.s.probe("chat-clear")
        time.sleep(1.5)

    def set(self, name, value):
        path = self.cfg + "." + name
        if path not in self.saved:
            self.saved[path] = self.s.field(path).get("value")
        self.s.field(path, value)

    def place(self, prefix, where):
        anchor, x, y, scale = where
        self.set(prefix + "Anchor", anchor)
        self.set(prefix + "X", x)
        self.set(prefix + "Y", y)
        self.set(prefix + "Scale", scale)

    def background(self, item, on):
        """An overlay item's Background switch, through the config's own setter; `restore` puts back what it was."""
        if item not in self.backgrounds:
            was = self.s.call("/invoke", post={"path": self.cfg + ".hudBackground", "args": item}).get("value")
            self.backgrounds[item] = was is not False
        self.s.call("/invoke", post={"path": self.cfg + ".setHudBackground", "args": ARG_SEP.join([item, str(on).lower()])})
        time.sleep(0.4)

    def restore(self):
        for item, was in self.backgrounds.items():
            self.s.try_call("/invoke", post={"path": self.cfg + ".setHudBackground",
                                             "args": ARG_SEP.join([item, str(was).lower()])})
        self.backgrounds = {}
        for path, value in self.saved.items():
            self.s.try_call("/field", post={"path": path,
                                            "value": str(value).lower() if isinstance(value, bool) else str(value)})
        self.saved = {}
        self.s.try_call("/probe", post={"name": "chat-heights", "args": "restore"})
        self.s.try_call("/command", post={"command": "/gamerule sendCommandFeedback true"})
        if self.scale is not None:
            self.s.try_call("/scale", {"n": self.scale})


def ov_chat_places(gui_w, chat_w=324.0):
    """OV_CHAT_PLACES with P2's large scale shrunk, if needed, so a vanilla-width chat still fits the GUI width
    (a 960 px window at GUI scale 2 is 480 GUI px: 324 x 1.5 would not fit and the box would clamp off its margin)."""
    places = []
    for tag, (anchor, x, y, scale) in OV_CHAT_PLACES:
        if chat_w * scale > gui_w - 12:
            scale = max(0.5, math.floor((gui_w - 12) / chat_w * 100) / 100.0)
        places.append((tag, (anchor, x, y, scale)))
    return places


def scoreboard_samples(box, scale, sf):
    """Device-px rects that hold only scoreboard fill: one column in the middle of the 2 px left margin (text starts
    after it), (lines below the title, the title row). Never empty for any item scale >= 0.3 at GUI scale >= 1."""
    x = int((box["x"] + scale) * sf)
    title_bottom = (box["y"] + 9 * scale) * sf
    lines = (x, int(math.ceil((box["y"] + 10 * scale) * sf)), x + 1, int((box["y"] + box["h"]) * sf))
    title = (x, int(math.ceil(box["y"] * sf)), x + 1, max(int(math.ceil(box["y"] * sf)) + 1, int(title_bottom)))
    return lines, title


def chat_margin_column(box, scale, sf, chat_scale=1.0):
    """The device column in the middle of the chat fill's right 4 chat px, where no text reaches."""
    return int((box["x"] + box["w"] - 2 * scale * chat_scale) * sf)


