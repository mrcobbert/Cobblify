def g30_problems(hb):
    """What differs from the default layout (G30) among the shown boxes of a hud-boxes probe; [] when none."""
    sw, sh = hb["sw"], hb["sh"]
    boxes = {b["id"]: vis(b) for b in hb["boxes"] if b["shown"]}
    problems = []

    def near(name, got, want, tol=1e-3):
        if abs(got - want) > tol:
            problems.append("%s %.3f, want %.3f" % (name, got, want))

    y = 2.0
    for i in LEFT_COLUMN:
        if i in boxes:
            x0, y0, w0, h0 = boxes[i]
            near(i + " x", x0, 2)
            near(i + " y", y0, y)
            y = y0 + h0 + 2
    timers_bottom = None
    if "diamondtimer" in boxes:
        x0, y0, w0, h0 = boxes["diamondtimer"]
        near("diamondtimer right", x0 + w0, sw - 2)
        near("diamondtimer y", y0, 2)
        timers_bottom = y0 + h0
        if "emeraldtimer" in boxes:
            x1, y1, w1, h1 = boxes["emeraldtimer"]
            near("emeraldtimer right", x1 + w1, x0 - 2)
            near("emeraldtimer y", y1, 2)
            timers_bottom = max(timers_bottom, y1 + h1)
    if "sessionstats" in boxes:
        x0, y0, w0, h0 = boxes["sessionstats"]
        near("sessionstats right", x0 + w0, sw - 2)
        near("sessionstats y", y0, 2 if timers_bottom is None else timers_bottom + 2)
    if "inventory" in boxes:
        x0, y0, w0, h0 = boxes["inventory"]
        near("inventory centre", x0 + w0 / 2.0, sw / 2.0, 0.5)
        near("inventory y", y0, 2)
    if "keystrokes" in boxes:
        x0, y0, w0, h0 = boxes["keystrokes"]
        near("keystrokes right", x0 + w0, sw - 2)
        near("keystrokes bottom", y0 + h0, sh - 2)
    if "heightlimit" in boxes:
        x0, y0, w0, h0 = boxes["heightlimit"]
        near("heightlimit x", x0, 2)
        near("heightlimit centre", y0 + h0 / 2.0, sh / 2.0, 0.5)
    return problems


def positions(hb):
    return {st["id"]: tuple(st.get(k) for k in POSITION_KEYS) for st in hb["states"]}


