  "authors": ["MrCobbert"],
  "environment": "client",
  "entrypoints": {
    "client-init": [
      "com.bedwarsqol.CobblifyOrnithe"
    ]
  },
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "1.8.9",
    "osl-entrypoints": "*",
    "osl-lifecycle-events": "*",
    "osl-keybinds": "*",
    "osl-resource-loader": "*",
    "osl-networking": "*"
  }
}
